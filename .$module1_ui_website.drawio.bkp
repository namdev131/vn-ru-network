        <mxCell id="s4_dr_title" value="&lt;b style=&quot;font-size:13px; color:#4a148c;&quot;&gt;🛠️ BẢNG THIẾT LẬP QUYỀN THEO DOMAIN SCOPE CHO: TS. NGUYỄN VĂN A (u_nguyenva)&lt;/b&gt;&lt;hr&gt;&lt;span style=&quot;font-size:11px; color:#455a64;&quot;&gt;Cấu trúc phân quyền 3 chiều theo chuẩn thiết kế: &lt;b&gt;authorize(identity, permission, resource_scope, active_context)&lt;/b&gt;&lt;/span&gt;" style="text;html=1;align=left;" vertex="1" parent="s4_drawer">
          <mxGeometry x="20" y="15" width="860" height="40" as="geometry" />
        </mxCell>

        <!-- Scope Panel 1 -->
        <mxCell id="dr_panel1" value="&lt;b style=&quot;color:#1565c0;&quot;&gt;Phân hệ Đề tài (GRANT / PROJECT DOMAIN)&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;☑ &lt;b&gt;GRANT.PROPOSAL.READ&lt;/b&gt; (Chỉ hồ sơ sở hữu: &lt;i&gt;ownerId = 'u_nguyenva'&lt;/i&gt;)&lt;br&gt;☑ &lt;b&gt;GRANT.PROPOSAL.SUBMIT&lt;/b&gt; (Nộp hồ sơ đề tài hợp tác song phương)&lt;br&gt;☑ &lt;b&gt;PROJECT.MILESTONE.UPDATE&lt;/b&gt; (Cập nhật tiến độ dự án của đơn vị)&lt;br&gt;☐ &lt;span style=&quot;color:#9e9e9e;&quot;&gt;GRANT.PROPOSAL.APPROVE&lt;/span&gt; &lt;i style=&quot;color:#c62828;&quot;&gt;(Cấm - Quyền Quỹ quản lý)&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#90caf9;align=left;spacingLeft=10;" vertex="1" parent="s4_drawer">
          <mxGeometry x="20" y="65" width="420" height="150" as="geometry" />
        </mxCell>

        <!-- Scope Panel 2 -->
        <mxCell id="dr_panel2" value="&lt;b style=&quot;color:#ef6c00;&quot;&gt;Phân hệ Phản biện (REVIEW DOMAIN - Scoped Assignment)&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;font-size:11px;&quot;&gt;☑ &lt;b&gt;REVIEW.ASSIGNMENT.READ&lt;/b&gt; (Ràng buộc: &lt;i&gt;assignmentId in ['R100', 'R104']&lt;/i&gt;)&lt;br&gt;☑ &lt;b&gt;REVIEW.SCORE.WRITE&lt;/b&gt; (Nhập phiếu điểm và nhận xét chuyên môn)&lt;br&gt;☑ &lt;b&gt;REVIEW.SUBMIT&lt;/b&gt; (Nộp kết quả phản biện lên Hội đồng)&lt;br&gt;☐ &lt;span style=&quot;color:#c62828;&quot;&gt;REVIEW.READ_ALL&lt;/span&gt; &lt;i style=&quot;color:#c62828;&quot;&gt;(Bị chặn - Không được xem đề tài ngoài danh sách)&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffcc80;align=left;spacingLeft=10;" vertex="1" parent="s4_drawer">
          <mxGeometry x="460" y="65" width="420" height="150" as="geometry" />
        </mxCell>

        <!-- Dynamic Scope Constraint Box -->
        <mxCell id="dr_scope_box" value="&lt;b&gt;Ràng buộc Resource Scope động (Dynamic Context Boundary):&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; font-family:Courier New, monospace;&quot;&gt;IF active_context == &apos;REVIEWER&apos; THEN scope_filter = { assigned_to: &apos;u_nguyenva&apos;, status: &apos;ACTIVE&apos; }&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#546e7a;&quot;&gt;Khi lưu, hệ thống tự động bắn tín hiệu &lt;b style=&quot;color:#d32f2f;&quot;&gt;Redis Invalidation&lt;/b&gt; để xóa cache quyền cũ của user trong 2ms.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#fff59d;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="s4_drawer">
          <mxGeometry x="20" y="230" width="860" height="65" as="geometry" />
