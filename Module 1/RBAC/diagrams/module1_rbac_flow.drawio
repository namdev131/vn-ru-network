        <mxCell id="e_step4_step5" value="8. Thẩm định Scope &amp;amp; Phân công" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeColor=#7e57c2;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pdp_step4" target="pdp_step5">
