        <!-- CLUSTER 4: RESOURCE SCOPES & AUDIT (ABAC & GOVERNANCE) -->
        <mxCell id="cl4_box" value="4. PHẠM VI &amp;amp; KIỂM TOÁN (ABAC &amp;amp; AUDIT)" style="swimlane;startSize=30;fillColor=#f0fdf4;strokeColor=#16a34a;fontStyle=1;fontSize=12;fontColor=#14532d;rounded=1;arcSize=3;" vertex="1" parent="1">
