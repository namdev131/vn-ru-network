        <mxCell id="erd_p_scope" value="1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeColor=#16a34a;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="tbl_perms" target="tbl_scopes">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1360" y="870" />
              <mxPoint x="1360" y="290" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="erd_u_rev_assign" value="1..*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeColor=#16a34a;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="tbl_assignments" target="tbl_review_assign">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="erd_sess_ctx" value="1..1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeColor=#0288d1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="tbl_sessions" target="tbl_contexts">
          <mxGeometry relative="1" as="geometry" />
