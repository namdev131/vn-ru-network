        <mxCell id="cl3_box" value="3. VAI TRÒ &amp;amp; QUYỀN HẠN (CORE RBAC)" style="swimlane;startSize=30;fillColor=#fff3e0;strokeColor=#ef6c00;fontStyle=1;fontSize=12;fontColor=#e65100;rounded=1;arcSize=3;" vertex="1" parent="1">
