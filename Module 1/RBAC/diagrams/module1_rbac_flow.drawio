        <mxCell id="e_authz_allow" value="CHO PHÉP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#2e7d32;strokeColor=#2e7d32;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pdp_authz_dec" target="pdp_allow_token">
