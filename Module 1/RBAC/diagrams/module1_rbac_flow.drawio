        <mxCell id="tbl_audit" value="&lt;b style=&quot;font-size: 13px; color: #004d40;&quot;&gt;iam_audit_logs (Nhật ký Kiểm toán An ninh)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; font-family: monospace; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color:#d32f2f;&quot;&gt;PK&lt;/b&gt; audit_id : BIGSERIAL&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;event_type : ENUM('AUTHN_SUCCESS', 'AUTHN_FAIL',&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;'AUTHZ_ALLOW', 'AUTHZ_DENIED',&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;'ROLE_CHANGE', 'SESSION_REVOKED')&lt;br&gt;&lt;b style=&quot;color:#1976d2;&quot;&gt;FK&lt;/b&gt; actor_user_id : VARCHAR(36)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;actor_role : VARCHAR(50)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;target_resource : VARCHAR(255)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;decision : ENUM('ALLOW', 'DENY')&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;ip_address, trace_id : VARCHAR(64)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;event_timestamp : TIMESTAMP&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e0f2f1;strokeColor=#00796b;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="cl4_box">
          <mxGeometry x="25" y="560" width="370" height="280" as="geometry" />
        </mxCell>

        <mxCell id="cl4_legend" value="&lt;b&gt;Quy tắc Phân định Phạm vi (Scopes):&lt;/b&gt;&lt;br&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 10px; line-height: 1.4;&quot;&gt;• &lt;b&gt;GLOBAL:&lt;/b&gt; Toàn quyền hệ thống (Chỉ Super Admin)&lt;br&gt;• &lt;b&gt;TENANT_BOUND:&lt;/b&gt; Chỉ trong phạm vi Tổ chức/Đơn vị&lt;br&gt;• &lt;b&gt;OWNER_ONLY:&lt;/b&gt; Chỉ dữ liệu do chính mình tạo ra&lt;br&gt;• &lt;b&gt;ASSIGNED_ONLY:&lt;/b&gt; Chỉ hồ sơ được Hội đồng phân công&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;fontSize=10;fontColor=#14532d;" vertex="1" parent="cl4_box">
