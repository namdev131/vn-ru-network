        <mxCell id="erd_ctx_audit" value="Emit Audit Events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#00796b;dashed=1;strokeWidth=1.2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="tbl_contexts" target="tbl_audit">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
