        <mxCell id="tbl_assignments" value="&lt;b style=&quot;font-size: 13px; color: #e65100;&quot;&gt;iam_user_role_assignments (Gán Quyền)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; font-family: monospace; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color:#d32f2f;&quot;&gt;PK&lt;/b&gt; assignment_id : VARCHAR(36)&lt;br&gt;&lt;b style=&quot;color:#1976d2;&quot;&gt;FK&lt;/b&gt; user_id : VARCHAR(36)&lt;br&gt;&lt;b style=&quot;color:#1976d2;&quot;&gt;FK&lt;/b&gt; role_id : VARCHAR(36)&lt;br&gt;&lt;b style=&quot;color:#1976d2;&quot;&gt;FK&lt;/b&gt; tenant_id : VARCHAR(36) [NULLABLE]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;valid_from : TIMESTAMP&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;valid_to : TIMESTAMP [NULLABLE]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;assignment_status : ENUM('ACTIVE', 'REVOKED')&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;assigned_by : VARCHAR(36)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="cl3_box">
