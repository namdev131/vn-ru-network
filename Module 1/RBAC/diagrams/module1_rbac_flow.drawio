<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="rbac_flow_page1" name="1. Luồng Xử lý Phân quyền &amp; Đánh giá Permission (PEP &amp; PDP Flow)">
    <mxGraphModel dx="1800" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1300">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Master Title Block -->
        <mxCell id="p1_title" value="&lt;b style=&quot;font-size: 20px; color: #0d47a1;&quot;&gt;LUỒNG XỬ LÝ PHÂN QUYỀN &amp;amp; ĐÁNH GIÁ PERMISSION (RBAC &amp;amp; PEP/PDP FLOW)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #455a64;&quot;&gt;VN–RU Portal · Module 1: IAM &amp;amp; Governance · Mô hình Xác thực, Phân giải Ngữ cảnh (Context Switch), Policy Enforcement Point (PEP) &amp;amp; Policy Decision Point (PDP)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#1976d2;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1760" height="75" as="geometry" />
        </mxCell>

        <!-- TIER 1: CLIENT ACCESS and REQUEST INITIATION -->
        <mxCell id="t1_swimlane" value="TẦNG 1: TRẢI NGHIỆM CLIENT &amp;amp; PHÁT KHỞI YÊU CẦU (CLIENT LAYER &amp;amp; ACTIVE CONTEXT)" style="swimlane;startSize=30;fillColor=#e1f5fe;strokeColor=#0288d1;fontStyle=1;fontSize=13;fontColor=#01579b;rounded=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="1760" height="190" as="geometry" />
        </mxCell>

        <mxCell id="c_actor" value="&lt;b style=&quot;font-size: 13px; color: #01579b;&quot;&gt;1. Actor / Người dùng&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• &lt;b&gt;Researcher&lt;/b&gt; (Nhà khoa học)&lt;br&gt;• &lt;b&gt;Reviewer&lt;/b&gt; (Chuyên gia phản biện)&lt;br&gt;• &lt;b&gt;Org Admin&lt;/b&gt; (Đại diện Viện/Trường)&lt;br&gt;• &lt;b&gt;Enterprise&lt;/b&gt; / &lt;b&gt;Operator&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t1_swimlane">
          <mxGeometry x="30" y="42" width="250" height="130" as="geometry" />
        </mxCell>

        <mxCell id="c_packet" value="&lt;b style=&quot;font-size: 12px; color: #01579b;&quot;&gt;2. HTTP Request Envelope&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 10px; font-family: monospace; line-height: 1.3;&quot;&gt;&lt;b style=&quot;color:#d32f2f;&quot;&gt;POST&lt;/b&gt; /api/v1/proposals/PR-2026/review&lt;br&gt;&lt;b style=&quot;color:#1976d2;&quot;&gt;Authorization:&lt;/b&gt; Bearer &amp;lt;JWT_Token&amp;gt;&lt;br&gt;&lt;b style=&quot;color:#7b1fa2;&quot;&gt;X-Active-Context:&lt;/b&gt; {tenantId:&quot;VAST&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;role:&quot;REVIEWER&quot;, scope:&quot;ASSIGNED&quot;}&lt;br&gt;&lt;b style=&quot;color:#388e3c;&quot;&gt;X-Trace-ID:&lt;/b&gt; trc-7f89ab12&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t1_swimlane">
          <mxGeometry x="320" y="42" width="340" height="130" as="geometry" />
        </mxCell>

        <mxCell id="c_ctx_switch" value="&lt;b style=&quot;font-size: 12px; color: #01579b;&quot;&gt;3. Cơ chế Context Switch&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• Chuyển đổi linh hoạt giữa các vai trò:&lt;br&gt;&amp;nbsp;&amp;nbsp;🏷️ &lt;i&gt;Nhà khoa học&lt;/i&gt; (Viện Hàn lâm VAST)&lt;br&gt;&amp;nbsp;&amp;nbsp;🏷️ &lt;i&gt;Chuyên gia thẩm định&lt;/i&gt; (Hội đồng Quỹ)&lt;br&gt;• Không cần đăng xuất/đăng nhập lại&lt;br&gt;• Session cập nhật &lt;b&gt;Active Context Token&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t1_swimlane">
          <mxGeometry x="700" y="42" width="330" height="130" as="geometry" />
        </mxCell>

        <mxCell id="c_storage" value="&lt;b style=&quot;font-size: 12px; color: #01579b;&quot;&gt;4. Trình duyệt &amp;amp; Lưu trữ Phiên&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• &lt;b&gt;HttpOnly Cookie:&lt;/b&gt; Session ID an toàn&lt;br&gt;• &lt;b&gt;Memory State:&lt;/b&gt; Short-lived Access Token&lt;br&gt;• &lt;b&gt;Local Context:&lt;/b&gt; Workspace active profile&lt;br&gt;• Tự động đính kèm Token vào API Calls&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t1_swimlane">
          <mxGeometry x="1070" y="42" width="310" height="130" as="geometry" />
        </mxCell>

        <mxCell id="c_public_bypass" value="&lt;b style=&quot;font-size: 12px; color: #2e7d32;&quot;&gt;5. Luồng Public / Discovery&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• Các route công khai (&lt;i&gt;/home, /news, /search, /experts, /onboarding&lt;/i&gt;)&lt;br&gt;• &lt;b style=&quot;color:#2e7d32;&quot;&gt;Bypass PEP Check:&lt;/b&gt; Truy cập trực tiếp qua Public Cache / Gateway mà không yêu cầu Token xác thực&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t1_swimlane">
          <mxGeometry x="1420" y="42" width="310" height="130" as="geometry" />
        </mxCell>

        <!-- TIER 2: POLICY ENFORCEMENT POINT (PEP) - API GATEWAY -->
        <mxCell id="t2_swimlane" value="TẦNG 2: POLICY ENFORCEMENT POINT (PEP) - API GATEWAY &amp;amp; XỬ LÝ ĐẦU VÀO" style="swimlane;startSize=30;fillColor=#fff3e0;strokeColor=#ef6c00;fontStyle=1;fontSize=13;fontColor=#e65100;rounded=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="1760" height="260" as="geometry" />
        </mxCell>

        <mxCell id="gw_ingress" value="&lt;b style=&quot;font-size: 13px; color: #e65100;&quot;&gt;API Gateway Ingress&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• TLS/SSL Termination (HTTPS)&lt;br&gt;• DDoS Protection &amp;amp; Rate Limiter&lt;br&gt;• Route Dispatcher &amp;amp; CORS Filter&lt;br&gt;• Sinh Trace ID cho toàn bộ luồng&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t2_swimlane">
          <mxGeometry x="30" y="48" width="250" height="185" as="geometry" />
        </mxCell>

        <mxCell id="gw_authn" value="&lt;b style=&quot;font-size: 13px; color: #e65100;&quot;&gt;Bước 1: Bộ lọc Xác thực (AuthN)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• &lt;b&gt;Xác thực Chữ ký JWT:&lt;/b&gt; RS256 Public Key&lt;br&gt;• &lt;b&gt;Kiểm tra Hạn dùng:&lt;/b&gt; exp, nbf, iat claims&lt;br&gt;• &lt;b&gt;Check Blacklist (Redis):&lt;/b&gt; Token bị revoke?&lt;br&gt;• &lt;b&gt;Kiểm tra 2FA Status:&lt;/b&gt; Session MFA hợp lệ?&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t2_swimlane">
          <mxGeometry x="315" y="48" width="280" height="185" as="geometry" />
        </mxCell>

        <mxCell id="gw_authn_dec" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;Token&lt;br&gt;Hợp lệ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="t2_swimlane">
          <mxGeometry x="635" y="85" width="110" height="90" as="geometry" />
        </mxCell>

        <mxCell id="gw_401_err" value="⛔ &lt;b&gt;401 Unauthorized&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Token hết hạn / Chữ ký sai&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=1.2;fontColor=#b71c1c;fontSize=11;" vertex="1" parent="t2_swimlane">
          <mxGeometry x="615" y="195" width="150" height="42" as="geometry" />
        </mxCell>

        <mxCell id="gw_ctx_resolver" value="&lt;b style=&quot;font-size: 13px; color: #e65100;&quot;&gt;Bước 2: Phân giải Ngữ cảnh (Context)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• Đọc header &lt;b&gt;X-Active-Context&lt;/b&gt;&lt;br&gt;• Trích xuất: &lt;i&gt;userId&lt;/i&gt;, &lt;i&gt;tenantId&lt;/i&gt;, &lt;i&gt;activeRole&lt;/i&gt;&lt;br&gt;• Xác minh quan hệ: User có quyền hoạt động dưới vai trò &lt;b&gt;REVIEWER&lt;/b&gt; tại tổ chức này?&lt;br&gt;• Khởi tạo Security Context ThreadLocal&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t2_swimlane">
          <mxGeometry x="785" y="48" width="300" height="185" as="geometry" />
        </mxCell>

        <mxCell id="gw_route_mapper" value="&lt;b style=&quot;font-size: 13px; color: #e65100;&quot;&gt;Bước 3: Ánh xạ Route sang Permission&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• Phân tích HTTP Method + URI Pattern:&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;POST /api/v1/proposals/{id}/review&lt;/code&gt;&lt;br&gt;• Quyền yêu cầu: &lt;b style=&quot;color:#c2185b;&quot;&gt;GRANT.PROPOSAL.REVIEW&lt;/b&gt;&lt;br&gt;• Kiểu kiểm tra: &lt;b&gt;Fine-Grained RBAC + Scope&lt;/b&gt;&lt;br&gt;• Đối tượng mục tiêu: &lt;i&gt;proposalId = &quot;PR-2026&quot;&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t2_swimlane">
          <mxGeometry x="1125" y="48" width="320" height="185" as="geometry" />
        </mxCell>

        <mxCell id="gw_pep_fwd" value="&lt;b style=&quot;font-size: 13px; color: #e65100;&quot;&gt;PEP Interceptor &amp;amp; Dispatch&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• Đóng gói Authorization Query:&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;{userId: &quot;USR-10&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp; activeRole: &quot;REVIEWER&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp; perm: &quot;GRANT.PROPOSAL.REVIEW&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp; resource: &quot;PR-2026&quot;}&lt;/code&gt;&lt;br&gt;• Chuyển tiếp tới &lt;b&gt;PDP AuthZ Engine&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t2_swimlane">
          <mxGeometry x="1485" y="48" width="245" height="185" as="geometry" />
        </mxCell>

        <!-- TIER 3: POLICY DECISION POINT (PDP) - CORE RBAC & ABAC ENGINE -->
        <mxCell id="t3_swimlane" value="TẦNG 3: POLICY DECISION POINT (PDP) - LÕI ĐÁNH GIÁ QUYỀN (RBAC &amp;amp; CONTEXTUAL SCOPE ENGINE)" style="swimlane;startSize=30;fillColor=#ede7f6;strokeColor=#7e57c2;fontStyle=1;fontSize=13;fontColor=#4a148c;rounded=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="625" width="1760" height="340" as="geometry" />
        </mxCell>

        <mxCell id="pdp_core" value="&lt;b style=&quot;font-size: 13px; color: #4a148c;&quot;&gt;PDP AuthZ Evaluation Controller&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• Điều phối thực thi hàm thẩm định:&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;b style=&quot;color:#4a148c;&quot;&gt;authorize(identity, perm, scope, ctx)&lt;/b&gt;&lt;br&gt;• Chiến lược thẩm định 2 pha:&lt;br&gt;&amp;nbsp;&amp;nbsp;1️⃣ &lt;b&gt;Pha RBAC:&lt;/b&gt; Role có quyền hay không?&lt;br&gt;&amp;nbsp;&amp;nbsp;2️⃣ &lt;b&gt;Pha ABAC:&lt;/b&gt; Phạm vi/Phân công hợp lệ?&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t3_swimlane">
          <mxGeometry x="30" y="50" width="300" height="160" as="geometry" />
        </mxCell>

        <mxCell id="pdp_redis" value="&lt;b style=&quot;font-size: 12px; color: #c2185b;&quot;&gt;⚡ L1 Fast-Path Cache (Redis &amp;lt;2ms)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 10px; line-height: 1.3;&quot;&gt;• Key: &lt;code&gt;rbac:perm:{userId}:{role}:{tenantId}&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Cache Hit:&lt;/b&gt; Trả về Set&amp;lt;Permissions&amp;gt; ngay&lt;br&gt;• &lt;b&gt;Cache Invalidation:&lt;/b&gt; Tự động xóa khi quyền/vai trò bị thay đổi hoặc phân công hết hạn&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#e91e63;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t3_swimlane">
          <mxGeometry x="370" y="48" width="290" height="120" as="geometry" />
        </mxCell>

        <mxCell id="pdp_pg" value="&lt;b style=&quot;font-size: 12px; color: #1565c0;&quot;&gt;🗄️ L2 Policy Store (PostgreSQL)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 10px; line-height: 1.3;&quot;&gt;• Bảng &lt;i&gt;iam_roles&lt;/i&gt;, &lt;i&gt;iam_permissions&lt;/i&gt;&lt;br&gt;• Bảng &lt;i&gt;iam_role_permissions&lt;/i&gt;&lt;br&gt;• Bảng &lt;i&gt;iam_user_role_assignments&lt;/i&gt;&lt;br&gt;• Bảng &lt;i&gt;grant_review_assignments&lt;/i&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t3_swimlane">
          <mxGeometry x="370" y="185" width="290" height="135" as="geometry" />
        </mxCell>

        <mxCell id="pdp_step4" value="&lt;b style=&quot;font-size: 13px; color: #4a148c;&quot;&gt;Bước 4: Thẩm định RBAC (Role-to-Perm)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• Kiểm tra trong tập quyền của &lt;b&gt;REVIEWER&lt;/b&gt;:&lt;br&gt;&amp;nbsp;&amp;nbsp;🔎 &lt;code&gt;contains(&quot;GRANT.PROPOSAL.REVIEW&quot;)&lt;/code&gt;&lt;br&gt;• Kết quả kiểm tra: &lt;b style=&quot;color:#2e7d32;&quot;&gt;TRUE (Role có quyền)&lt;/b&gt;&lt;br&gt;• Nếu không có quyền → Quyết định DENY ngay&lt;br&gt;• Nếu có quyền → Chuyển sang thẩm định Scope&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t3_swimlane">
          <mxGeometry x="700" y="50" width="310" height="160" as="geometry" />
        </mxCell>

        <mxCell id="pdp_step5" value="&lt;b style=&quot;font-size: 13px; color: #4a148c;&quot;&gt;Bước 5: Thẩm định Phạm vi &amp;amp; Phân công (Scope)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• Kiểm tra quy tắc phân công thực tế:&lt;br&gt;&amp;nbsp;&amp;nbsp;🔐 &lt;i&gt;isAssignedReviewer(userId, proposalId == &quot;PR-2026&quot;)&lt;/i&gt;&lt;br&gt;• Đối chiếu bảng phân công: &lt;b style=&quot;color:#2e7d32;&quot;&gt;MATCH (Được phân công)&lt;/b&gt;&lt;br&gt;• Ngăn chặn tuyệt đối việc Reviewer xem đề xuất ngoài danh sách phân công (Strict Isolation)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t3_swimlane">
          <mxGeometry x="1050" y="50" width="350" height="160" as="geometry" />
        </mxCell>

        <mxCell id="pdp_authz_dec" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;Quyền &amp;amp;&lt;br&gt;Scope&lt;br&gt;Hợp lệ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="t3_swimlane">
          <mxGeometry x="1445" y="85" width="110" height="90" as="geometry" />
        </mxCell>

        <mxCell id="pdp_403_deny" value="🚫 &lt;b style=&quot;font-size: 13px;&quot;&gt;403 Forbidden&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 10px; line-height: 1.3;&quot;&gt;• &lt;b&gt;Từ chối truy cập:&lt;/b&gt; Không có quyền hoặc không thuộc phạm vi phân công&lt;br&gt;• &lt;b&gt;Phát sự kiện An ninh:&lt;/b&gt; &lt;code&gt;AUDIT.AUTHZ_DENIED&lt;/code&gt;&lt;br&gt;• Trả mã lỗi 403 về Gateway &amp;amp; Client&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=1.5;fontColor=#b71c1c;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t3_swimlane">
          <mxGeometry x="1405" y="205" width="190" height="115" as="geometry" />
        </mxCell>

        <mxCell id="pdp_allow_token" value="&lt;b style=&quot;color:#1b5e20; font-size:11px;&quot;&gt;✅ DECISION: ALLOW&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#2e7d32;&quot;&gt;Pass PEP Security Gate&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.2;" vertex="1" parent="t3_swimlane">
          <mxGeometry x="1600" y="105" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- TIER 4: DOWNSTREAM SERVICES AND GOVERNANCE AUDIT TRAIL -->
        <mxCell id="t4_swimlane" value="TẦNG 4: THỰC THI NGHIỆP VỤ &amp;amp; NHẬT KÝ KIỂM TOÁN (DOWNSTREAM SERVICES &amp;amp; GOVERNANCE AUDIT TRAIL)" style="swimlane;startSize=30;fillColor=#f0fdf4;strokeColor=#16a34a;fontStyle=1;fontSize=13;fontColor=#14532d;rounded=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="990" width="1760" height="270" as="geometry" />
        </mxCell>

        <mxCell id="down_hdr" value="&lt;b style=&quot;font-size: 12px; color: #16a34a;&quot;&gt;1. Gắn Trusted Security Headers&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 10px; font-family: monospace; line-height: 1.3;&quot;&gt;&lt;b style=&quot;color:#1565c0;&quot;&gt;X-User-Id:&lt;/b&gt; USR-8821&lt;br&gt;&lt;b style=&quot;color:#7b1fa2;&quot;&gt;X-Tenant-Id:&lt;/b&gt; VAST-01&lt;br&gt;&lt;b style=&quot;color:#e65100;&quot;&gt;X-Active-Role:&lt;/b&gt; REVIEWER&lt;br&gt;&lt;b style=&quot;color:#2e7d32;&quot;&gt;X-Granted-Scopes:&lt;/b&gt; ASSIGNED_ONLY&lt;br&gt;&lt;b style=&quot;color:#00838f;&quot;&gt;X-Audit-Trace-ID:&lt;/b&gt; TRC-9901-A7&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t4_swimlane">
          <mxGeometry x="30" y="48" width="280" height="195" as="geometry" />
        </mxCell>

        <mxCell id="down_services" value="&lt;b style=&quot;font-size: 13px; color: #16a34a;&quot;&gt;2. Các Microservices Nghiệp vụ (Target Domain Services)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.5;&quot;&gt;• &lt;b style=&quot;color:#0d47a1;&quot;&gt;Grant &amp;amp; Proposal Service (Module 3):&lt;/b&gt; Lưu kết quả đánh giá, tính điểm chuyên gia cho hồ sơ &lt;i&gt;PR-2026&lt;/i&gt;&lt;br&gt;• &lt;b style=&quot;color:#00695c;&quot;&gt;Knowledge &amp;amp; Expert Service (Module 2):&lt;/b&gt; Công bố bài báo, hồ sơ nghiên cứu&lt;br&gt;• &lt;b style=&quot;color:#e65100;&quot;&gt;Organization Service:&lt;/b&gt; Quản lý đơn vị thành viên, viện đối tác song phương&lt;br&gt;• &lt;b style=&quot;color:#6a1b9a;&quot;&gt;Tech Transfer Service (Module 5):&lt;/b&gt; Kết nối hợp tác doanh nghiệp mô hình 2+2&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t4_swimlane">
          <mxGeometry x="340" y="48" width="530" height="195" as="geometry" />
        </mxCell>

        <mxCell id="down_resp" value="&lt;b style=&quot;font-size: 13px; color: #16a34a;&quot;&gt;3. Phản hồi Kết quả&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• HTTP &lt;b style=&quot;color:#2e7d32;&quot;&gt;200 OK / 201 Created&lt;/b&gt;&lt;br&gt;• Payload kết quả an toàn trả về Client Web&lt;br&gt;• UI cập nhật trạng thái hồ sơ phản biện thành công&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t4_swimlane">
          <mxGeometry x="900" y="48" width="240" height="195" as="geometry" />
        </mxCell>

        <mxCell id="down_mq" value="&lt;b style=&quot;font-size: 13px; color: #16a34a;&quot;&gt;4. Luồng Sự kiện Bất đồng bộ&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• &lt;b&gt;Kafka / RabbitMQ Event Stream:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;📢 &lt;code&gt;AUDIT.AUTHZ_SUCCESS&lt;/code&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;📢 &lt;code&gt;AUDIT.PROPOSAL_REVIEWED&lt;/code&gt;&lt;br&gt;• Gửi bất đồng bộ (Non-blocking), bảo đảm độ trễ API thấp nhất (&amp;lt;15ms)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t4_swimlane">
          <mxGeometry x="1170" y="48" width="270" height="195" as="geometry" />
        </mxCell>

        <mxCell id="down_audit_db" value="&lt;b style=&quot;font-size: 12px; color: #004d40;&quot;&gt;🛡️ Kho Lưu trữ Kiểm toán Bảo mật (Audit Log DB)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 10px; line-height: 1.3;&quot;&gt;• Bảng &lt;i&gt;iam_audit_logs&lt;/i&gt;, Elasticsearch SIEM&lt;br&gt;• Bằng chứng bất biến (Immutable / WORM)&lt;br&gt;• Phục vụ rà soát tuân thủ, điều tra an ninh &amp;amp; Báo cáo Lãnh đạo Quỹ (Module 6)&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e0f2f1;strokeColor=#00796b;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="t4_swimlane">
          <mxGeometry x="1470" y="48" width="260" height="195" as="geometry" />
        </mxCell>

        <!-- Connections -->
        <mxCell id="e_c1_c2" value="1. Gửi Thao tác" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeColor=#0288d1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c_actor" target="c_packet">
