        <mxCell id="e_allow_downstream" value="9. Chuyển tiếp &amp;amp; Gắn Security Header" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#14532d;strokeColor=#16a34a;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pdp_allow_token" target="down_hdr">
