        <mxCell id="e_pdp_pg" value="Cache Miss: Query DB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#1976d2;dashed=1;strokeWidth=1.2;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="pdp_core" target="pdp_pg">
          <mxGeometry relative="1" as="geometry" />
