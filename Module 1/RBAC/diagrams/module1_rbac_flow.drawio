        <mxCell id="e_pep_pdp" value="6. Yêu cầu Thẩm định PDP (AuthZ Query)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;fontColor=#4a148c;strokeColor=#7e57c2;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gw_pep_fwd" target="pdp_core">
