        <mxCell id="tbl_roles" value="&lt;b style=&quot;font-size: 13px; color: #e65100;&quot;&gt;iam_roles (Danh mục Vai trò)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; font-family: monospace; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color:#d32f2f;&quot;&gt;PK&lt;/b&gt; role_id : VARCHAR(36)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;role_code : VARCHAR(50) [UNIQUE]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;('RESEARCHER', 'REVIEWER', 'ORG_ADMIN',&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;'ENTERPRISE', 'LEADERSHIP', 'IAM_ADMIN')&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;role_name : VARCHAR(150)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;role_category : ENUM('PUBLIC', 'WORKSPACE',&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;'GOVERNANCE')&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;is_system_role : BOOLEAN DEFAULT TRUE&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;is_active : BOOLEAN DEFAULT TRUE&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="cl3_box">
          <mxGeometry x="25" y="48" width="390" height="240" as="geometry" />
