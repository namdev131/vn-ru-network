        <mxCell id="tbl_role_perms" value="&lt;b style=&quot;font-size: 13px; color: #e65100;&quot;&gt;iam_role_permissions (Quan hệ Role ↔ Perm)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; font-family: monospace; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color:#d32f2f;&quot;&gt;PK&lt;/b&gt; (&lt;b style=&quot;color:#1976d2;&quot;&gt;FK&lt;/b&gt; role_id, &lt;b style=&quot;color:#1976d2;&quot;&gt;FK&lt;/b&gt; permission_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;granted_at : TIMESTAMP&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;granted_by : VARCHAR(36)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="cl3_box">
          <mxGeometry x="25" y="560" width="390" height="135" as="geometry" />
        </mxCell>

        <mxCell id="tbl_perms" value="&lt;b style=&quot;font-size: 13px; color: #e65100;&quot;&gt;iam_permissions (Từ điển Quyền hạt mịn)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; font-family: monospace; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color:#d32f2f;&quot;&gt;PK&lt;/b&gt; permission_id : VARCHAR(36)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;perm_code : VARCHAR(100) [UNIQUE]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b style=&quot;color:#c2185b;&quot;&gt;Pattern: &amp;lt;DOMAIN&amp;gt;.&amp;lt;RESOURCE&amp;gt;.&amp;lt;ACTION&amp;gt;&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;('GRANT.PROPOSAL.REVIEW', 'IAM.USER.MANAGE')&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;domain : ENUM('IAM', 'GRANT', 'KNOWLEDGE',&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;'ORG', 'TECH', 'AUDIT')&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;action_type : ENUM('CREATE', 'READ', 'UPDATE',&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;'DELETE', 'APPROVE')&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;description : VARCHAR(255)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="cl3_box">
          <mxGeometry x="25" y="725" width="390" height="250" as="geometry" />
        </mxCell>

        <mxCell id="cl3_note" value="🔑 &lt;b&gt;Fine-Grained RBAC:&lt;/b&gt; Phân quyền chuẩn hóa dạng DOMAIN.RESOURCE.ACTION giúp kiểm soát chính xác tới từng API endpoint." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ffb74d;fontSize=10;fontColor=#e65100;" vertex="1" parent="cl3_box">
          <mxGeometry x="25" y="1000" width="390" height="70" as="geometry" />
