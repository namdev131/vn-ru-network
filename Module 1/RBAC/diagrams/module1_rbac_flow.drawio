        <mxCell id="tbl_scopes" value="&lt;b style=&quot;font-size: 13px; color: #14532d;&quot;&gt;iam_resource_scopes (Quy tắc Phạm vi ABAC)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; font-family: monospace; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color:#d32f2f;&quot;&gt;PK&lt;/b&gt; scope_id : VARCHAR(36)&lt;br&gt;&lt;b style=&quot;color:#1976d2;&quot;&gt;FK&lt;/b&gt; permission_id : VARCHAR(36)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;scope_type : ENUM('GLOBAL', 'TENANT_BOUND',&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;'OWNER_ONLY', 'ASSIGNED_ONLY')&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;condition_expression : TEXT [SpEL / CEL]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;('resource.tenantId == ctx.tenantId')&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;priority : INT DEFAULT 100&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="cl4_box">
          <mxGeometry x="25" y="48" width="370" height="235" as="geometry" />
        </mxCell>

        <mxCell id="tbl_review_assign" value="&lt;b style=&quot;font-size: 13px; color: #14532d;&quot;&gt;grant_review_assignments (Phân công)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; font-family: monospace; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color:#d32f2f;&quot;&gt;PK&lt;/b&gt; review_assignment_id : VARCHAR(36)&lt;br&gt;&lt;b style=&quot;color:#1976d2;&quot;&gt;FK&lt;/b&gt; reviewer_user_id : VARCHAR(36)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;proposal_id : VARCHAR(36)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;round_no : INT DEFAULT 1&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;status : ENUM('ASSIGNED', 'SUBMITTED')&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;assigned_at : TIMESTAMP&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;deadline : TIMESTAMP&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="cl4_box">
          <mxGeometry x="25" y="315" width="370" height="215" as="geometry" />
