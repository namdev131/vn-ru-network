  <diagram id="rbac_data_model_page2" name="2. Mô hình Thực thể Dữ liệu RBAC &amp; Phân cấp Ngữ cảnh (Data Model)">
    <mxGraphModel dx="1800" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1280">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Master Title Block -->
        <mxCell id="p2_title" value="&lt;b style=&quot;font-size: 20px; color: #311b92;&quot;&gt;MÔ HÌNH THỰC THỂ DỮ LIỆU RBAC &amp;amp; PHÂN CẤP NGỮ CẢNH (DATA SCHEMA &amp;amp; CONTEXT)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #455a64;&quot;&gt;Cấu trúc Cơ sở Dữ liệu Quan hệ: User Account ↔ Multi-Tenant Context ↔ Dynamic Role ↔ Fine-grained Permission &amp;amp; ABAC Scope Rules&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1760" height="75" as="geometry" />
        </mxCell>

        <!-- CLUSTER 1: IDENTITY & SESSION -->
        <mxCell id="cl1_box" value="1. ĐỊNH DANH &amp;amp; PHIÊN (IDENTITY &amp;amp; SESSION)" style="swimlane;startSize=30;fillColor=#ede7f6;strokeColor=#7e57c2;fontStyle=1;fontSize=12;fontColor=#4a148c;rounded=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="410" height="1100" as="geometry" />
        </mxCell>

        <mxCell id="tbl_users" value="&lt;b style=&quot;font-size: 13px; color: #311b92;&quot;&gt;iam_users (Tài khoản Người dùng)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; font-family: monospace; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color:#d32f2f;&quot;&gt;PK&lt;/b&gt; user_id : VARCHAR(36)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;email : VARCHAR(255) [UNIQUE]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;full_name : VARCHAR(255)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;orcid_id : VARCHAR(64) [NULLABLE]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;user_type : ENUM('INDIVIDUAL', 'AFFILIATED')&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;status : ENUM('PENDING', 'ACTIVE', 'LOCKED')&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;is_2fa_enabled : BOOLEAN&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;default_tenant_id : VARCHAR(36)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;created_at, updated_at : TIMESTAMP&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="cl1_box">
          <mxGeometry x="25" y="48" width="360" height="235" as="geometry" />
        </mxCell>

        <mxCell id="tbl_creds" value="&lt;b style=&quot;font-size: 13px; color: #311b92;&quot;&gt;iam_user_credentials (Thông tin Xác thực)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; font-family: monospace; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color:#d32f2f;&quot;&gt;PK&lt;/b&gt; credential_id : VARCHAR(36)&lt;br&gt;&lt;b style=&quot;color:#1976d2;&quot;&gt;FK&lt;/b&gt; user_id : VARCHAR(36)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;password_hash : VARCHAR(255) [Argon2id]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;mfa_secret_encrypted : VARCHAR(255)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;failed_attempts : INT DEFAULT 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;locked_until : TIMESTAMP [NULLABLE]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;last_password_changed : TIMESTAMP&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="cl1_box">
          <mxGeometry x="25" y="315" width="360" height="195" as="geometry" />
        </mxCell>

        <mxCell id="tbl_sessions" value="&lt;b style=&quot;font-size: 13px; color: #311b92;&quot;&gt;iam_user_sessions (Phiên Hoạt động)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; font-family: monospace; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color:#d32f2f;&quot;&gt;PK&lt;/b&gt; session_id : VARCHAR(64)&lt;br&gt;&lt;b style=&quot;color:#1976d2;&quot;&gt;FK&lt;/b&gt; user_id : VARCHAR(36)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;refresh_token_hash : VARCHAR(255)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;device_fingerprint : VARCHAR(128)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;ip_address : VARCHAR(45)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;is_revoked : BOOLEAN DEFAULT FALSE&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;expires_at : TIMESTAMP&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;created_at : TIMESTAMP&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="cl1_box">
          <mxGeometry x="25" y="540" width="360" height="225" as="geometry" />
        </mxCell>

        <mxCell id="tbl_mfa" value="&lt;b style=&quot;font-size: 13px; color: #311b92;&quot;&gt;iam_mfa_devices (Thiết bị 2FA)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; font-family: monospace; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color:#d32f2f;&quot;&gt;PK&lt;/b&gt; mfa_id : VARCHAR(36)&lt;br&gt;&lt;b style=&quot;color:#1976d2;&quot;&gt;FK&lt;/b&gt; user_id : VARCHAR(36)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;mfa_type : ENUM('TOTP_APP', 'EMAIL_OTP')&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;device_label : VARCHAR(100)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;is_verified : BOOLEAN&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;last_used_at : TIMESTAMP&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="cl1_box">
          <mxGeometry x="25" y="795" width="360" height="180" as="geometry" />
        </mxCell>

        <mxCell id="cl1_note" value="🛡️ &lt;b&gt;Nguyên tắc An ninh:&lt;/b&gt; Khóa phiên tức thì trên Redis khi đổi mật khẩu hoặc phát hiện hành vi xâm nhập." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#ab47bc;fontSize=10;fontColor=#4a148c;" vertex="1" parent="cl1_box">
          <mxGeometry x="25" y="1000" width="360" height="70" as="geometry" />
        </mxCell>

        <!-- CLUSTER 2: TENANCY & MULTI-CONTEXT -->
        <mxCell id="cl2_box" value="2. ĐƠN VỊ &amp;amp; NGỮ CẢNH (TENANT &amp;amp; CONTEXT)" style="swimlane;startSize=30;fillColor=#e1f5fe;strokeColor=#0288d1;fontStyle=1;fontSize=12;fontColor=#01579b;rounded=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="480" y="125" width="400" height="1100" as="geometry" />
        </mxCell>

        <mxCell id="tbl_tenants" value="&lt;b style=&quot;font-size: 13px; color: #01579b;&quot;&gt;org_tenants (Tổ chức / Đơn vị Thành viên)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; font-family: monospace; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color:#d32f2f;&quot;&gt;PK&lt;/b&gt; tenant_id : VARCHAR(36)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;tenant_code : VARCHAR(50) [UNIQUE]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;tenant_name : VARCHAR(255)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;tenant_type : ENUM('INSTITUTE', 'UNIVERSITY',&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;'ENTERPRISE', 'FUND')&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;country_code : ENUM('VN', 'RU')&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;partner_status : ENUM('MOU_ACTIVE', 'PENDING')&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;is_active : BOOLEAN DEFAULT TRUE&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="cl2_box">
          <mxGeometry x="25" y="48" width="350" height="235" as="geometry" />
        </mxCell>

        <mxCell id="tbl_affils" value="&lt;b style=&quot;font-size: 13px; color: #01579b;&quot;&gt;iam_user_affiliations (Quan hệ Trực thuộc)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; font-family: monospace; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color:#d32f2f;&quot;&gt;PK&lt;/b&gt; affiliation_id : VARCHAR(36)&lt;br&gt;&lt;b style=&quot;color:#1976d2;&quot;&gt;FK&lt;/b&gt; user_id : VARCHAR(36)&lt;br&gt;&lt;b style=&quot;color:#1976d2;&quot;&gt;FK&lt;/b&gt; tenant_id : VARCHAR(36)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;position_title : VARCHAR(150)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;verification_status : ENUM('VERIFIED',&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;'CONSENT_PENDING')&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;consent_document_ref : VARCHAR(255)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;is_primary_org : BOOLEAN&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="cl2_box">
          <mxGeometry x="25" y="315" width="350" height="205" as="geometry" />
        </mxCell>

        <mxCell id="tbl_contexts" value="&lt;b style=&quot;font-size: 13px; color: #01579b;&quot;&gt;iam_active_contexts (Ngữ cảnh Đang chọn)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; font-family: monospace; line-height: 1.4;&quot;&gt;&lt;b style=&quot;color:#d32f2f;&quot;&gt;PK&lt;/b&gt; context_id : VARCHAR(36)&lt;br&gt;&lt;b style=&quot;color:#1976d2;&quot;&gt;FK&lt;/b&gt; session_id : VARCHAR(64)&lt;br&gt;&lt;b style=&quot;color:#1976d2;&quot;&gt;FK&lt;/b&gt; user_id : VARCHAR(36)&lt;br&gt;&lt;b style=&quot;color:#1976d2;&quot;&gt;FK&lt;/b&gt; tenant_id : VARCHAR(36)&lt;br&gt;&lt;b style=&quot;color:#1976d2;&quot;&gt;FK&lt;/b&gt; active_role_id : VARCHAR(36)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;context_token : VARCHAR(512)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;switched_at : TIMESTAMP&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="cl2_box">
          <mxGeometry x="25" y="550" width="350" height="215" as="geometry" />
