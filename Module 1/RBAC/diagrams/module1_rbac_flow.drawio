        <mxCell id="e_pdp_redis" value="Tra cứu Cache" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;strokeColor=#e91e63;strokeWidth=1.2;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="pdp_core" target="pdp_redis">
          <mxGeometry relative="1" as="geometry" />
