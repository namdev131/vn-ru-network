        <mxCell id="e_ctx_mapper" value="4. Gắn Ngữ cảnh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;strokeColor=#ef6c00;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="gw_ctx_resolver" target="gw_route_mapper">
