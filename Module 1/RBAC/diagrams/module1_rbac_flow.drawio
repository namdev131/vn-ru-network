  </diagram>
  <diagram id="rbac_matrix_page3" name="3. Ma trận Phân quyền RBAC theo 3 Vùng Canonical (Matrix)">
    <mxGraphModel dx="1800" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1360">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Master Title Block -->
        <mxCell id="p3_title" value="&lt;b style=&quot;font-size: 20px; color: #1e3a8a;&quot;&gt;MA TRẬN PHÂN QUYỀN RBAC CHI TIẾT THEO 3 VÙNG CANONICAL TRUY CẬP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #475569;&quot;&gt;Bảng Ánh xạ Phân định Quyền hạn (Permissions) cho từng Vai trò (Roles) trên 3 Khu vực: Public / Discovery, Role-based Workspace &amp;amp; Governance Admin&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#3b82f6;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1760" height="75" as="geometry" />
        </mxCell>

        <!-- ZONE 1: PUBLIC / DISCOVERY -->
        <mxCell id="z1_container" value="KHU VỰC 1: PUBLIC / DISCOVERY (TRUY CẬP CÔNG KHAI - KHÔNG YÊU CẦU XÁC THỰC)" style="swimlane;startSize=30;fillColor=#f0fdf4;strokeColor=#16a34a;fontStyle=1;fontSize=13;fontColor=#15803d;rounded=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="1760" height="190" as="geometry" />
        </mxCell>

        <mxCell id="z1_card_vis" value="&lt;b style=&quot;font-size: 13px; color: #15803d;&quot;&gt;🌐 ANONYMOUS / VISITOR (Khách vãng lai)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.5;&quot;&gt;• &lt;b&gt;Mục tiêu:&lt;/b&gt; Khám phá tin tức, tra cứu chuyên gia &amp;amp; công bố khoa học&lt;br&gt;• ✅ &lt;code&gt;PUBLIC.PORTAL.HOME_VIEW&lt;/code&gt; — Xem trang chủ, tin tức &amp;amp; sự kiện&lt;br&gt;• ✅ &lt;code&gt;KNOWLEDGE.DOC.SEARCH_PUBLIC&lt;/code&gt; — Tra cứu kho tri thức mở&lt;br&gt;• ✅ &lt;code&gt;EXPERT.DIRECTORY.SEARCH&lt;/code&gt; — Tìm kiếm hồ sơ chuyên gia công khai&lt;br&gt;• ✅ &lt;code&gt;GRANT.OPPORTUNITY.READ&lt;/code&gt; — Xem danh mục kêu gọi tài trợ mở&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="z1_container">
          <mxGeometry x="30" y="45" width="830" height="130" as="geometry" />
        </mxCell>

        <mxCell id="z1_card_onb" value="&lt;b style=&quot;font-size: 13px; color: #15803d;&quot;&gt;📝 ONBOARDING APPLICANT (Đăng ký Gia nhập Mạng lưới)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.5;&quot;&gt;• &lt;b&gt;Mục tiêu:&lt;/b&gt; Gửi hồ sơ đăng ký thành viên cá nhân / thỏa thuận đối tác tổ chức&lt;br&gt;• ✅ &lt;code&gt;IAM.ONBOARDING.REGISTER_INDIVIDUAL&lt;/code&gt; — Đăng ký nhà khoa học độc lập&lt;br&gt;• ✅ &lt;code&gt;IAM.ONBOARDING.SUBMIT_AFFILIATION&lt;/code&gt; — Gửi minh chứng đồng ý của cơ quan&lt;br&gt;• ✅ &lt;code&gt;ORG.PARTNER.SUBMIT_MOU_REQUEST&lt;/code&gt; — Gửi hồ sơ thỏa thuận hợp tác với Quỹ&lt;br&gt;• ❌ &lt;i style=&quot;color:#dc2626;&quot;&gt;Không có quyền truy cập bất kỳ Workspace nội bộ nào khi chưa được kích hoạt&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="z1_container">
          <mxGeometry x="890" y="45" width="840" height="130" as="geometry" />
        </mxCell>

        <!-- ZONE 2: ROLE-BASED WORKSPACE -->
        <mxCell id="z2_container" value="KHU VỰC 2: ROLE-BASED WORKSPACE (KHÔNG GIAN LÀM VIỆC THEO VAI TRÒ &amp;amp; NGỮ CẢNH TỔ CHỨC)" style="swimlane;startSize=30;fillColor=#eef2ff;strokeColor=#6366f1;fontStyle=1;fontSize=13;fontColor=#3730a3;rounded=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="335" width="1760" height="490" as="geometry" />
        </mxCell>

        <mxCell id="r_researcher" value="&lt;b style=&quot;font-size: 13px; color: #4338ca;&quot;&gt;🔬 RESEARCHER / SCIENTIST&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748b;&quot;&gt;Phạm vi: Cá nhân (OWNER_ONLY)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• ✅ &lt;code&gt;RESEARCHER.PROFILE.MANAGE&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;GRANT.PROPOSAL.DRAFT_SUBMIT&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;GRANT.PROPOSAL.READ_OWN&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;PROJECT.MILESTONE.UPDATE_OWN&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;KNOWLEDGE.DOC.PUBLISH_DRAFT&lt;/code&gt;&lt;br&gt;• ❌ &lt;code style=&quot;color:#dc2626;&quot;&gt;GRANT.PROPOSAL.REVIEW&lt;/code&gt; (Deny)&lt;br&gt;• ❌ &lt;code style=&quot;color:#dc2626;&quot;&gt;ORG.ADMIN.MANAGE&lt;/code&gt; (Deny)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6366f1;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="z2_container">
          <mxGeometry x="30" y="48" width="320" height="205" as="geometry" />
        </mxCell>

        <mxCell id="r_reviewer" value="&lt;b style=&quot;font-size: 13px; color: #4338ca;&quot;&gt;⚖️ REVIEWER (Chuyên gia Phản biện)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748b;&quot;&gt;Phạm vi: Hồ sơ được giao (ASSIGNED_ONLY)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• ✅ &lt;code&gt;GRANT.ASSIGNMENT.VIEW_ASSIGNED&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;GRANT.PROPOSAL.READ_ASSIGNED&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;GRANT.SCORE.INPUT_EVALUATION&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;GRANT.REVIEW.SUBMIT_REPORT&lt;/code&gt;&lt;br&gt;• ❌ &lt;code style=&quot;color:#dc2626;&quot;&gt;GRANT.PROPOSAL.READ_UNASSIGNED&lt;/code&gt;&lt;br&gt;• ❌ &lt;code style=&quot;color:#dc2626;&quot;&gt;GRANT.PROPOSAL.FINAL_APPROVE&lt;/code&gt;&lt;br&gt;• 🔒 &lt;i&gt;Cô lập hồ sơ ngoài phân công&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6366f1;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="z2_container">
          <mxGeometry x="375" y="48" width="325" height="205" as="geometry" />
        </mxCell>

        <mxCell id="r_org_rep" value="&lt;b style=&quot;font-size: 13px; color: #4338ca;&quot;&gt;🏛️ ORG_REPRESENTATIVE (Viện / Trường)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748b;&quot;&gt;Phạm vi: Toàn đơn vị (TENANT_BOUND)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• ✅ &lt;code&gt;ORG.PROFILE.UPDATE_INFO&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;ORG.MEMBER.VERIFY_AFFILIATION&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;GRANT.PROPOSAL.ENDORSE_ORG&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;GRANT.PROJECT.TRACK_ORG_DASHBOARD&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;ORG.MOU.VIEW_STATUS&lt;/code&gt;&lt;br&gt;• ❌ &lt;code style=&quot;color:#dc2626;&quot;&gt;ORG.OTHER_TENANT.VIEW&lt;/code&gt; (Deny)&lt;br&gt;• ❌ &lt;code style=&quot;color:#dc2626;&quot;&gt;GOVERNANCE.ADMIN.ACCESS&lt;/code&gt; (Deny)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6366f1;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="z2_container">
          <mxGeometry x="725" y="48" width="325" height="205" as="geometry" />
        </mxCell>

        <mxCell id="r_enterprise" value="&lt;b style=&quot;font-size: 13px; color: #4338ca;&quot;&gt;🏭 ENTERPRISE_USER (Doanh nghiệp CN)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748b;&quot;&gt;Phạm vi: Doanh nghiệp (TENANT_BOUND)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• ✅ &lt;code&gt;TECH.DEMAND.SUBMIT_RND_NEED&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;TECH.TRANSFER.PROPOSE_2PLUS2&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;TECH.CATALOG.SEARCH_PATENT&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;TECH.COMMERCIAL.TRACK_PROJECT&lt;/code&gt;&lt;br&gt;• ❌ &lt;code style=&quot;color:#dc2626;&quot;&gt;GRANT.PROPOSAL.REVIEW&lt;/code&gt; (Deny)&lt;br&gt;• ❌ &lt;code style=&quot;color:#dc2626;&quot;&gt;KNOWLEDGE.ADMIN.MANAGE&lt;/code&gt; (Deny)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6366f1;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="z2_container">
          <mxGeometry x="1075" y="48" width="320" height="205" as="geometry" />
        </mxCell>

        <mxCell id="r_leadership" value="&lt;b style=&quot;font-size: 13px; color: #4338ca;&quot;&gt;🎖️ LEADERSHIP (Lãnh đạo Quỹ / Điều hành)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #64748b;&quot;&gt;Phạm vi: Tổng hợp Song phương (AGGREGATE)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• ✅ &lt;code&gt;REPORT.KPI.VIEW_EXECUTIVE_DASHBOARD&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;REPORT.BILATERAL.VIEW_SUMMARY_STATS&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;GRANT.DECISION.VIEW_FUND_SUMMARY&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;TECH.TRANSFER.VIEW_MACRO_METRICS&lt;/code&gt;&lt;br&gt;• 🔒 &lt;i&gt;Chế độ Read-Only tổng hợp số liệu, không can thiệp sâu quản trị kỹ thuật&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6366f1;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="z2_container">
          <mxGeometry x="1420" y="48" width="310" height="205" as="geometry" />
        </mxCell>

        <mxCell id="z2_summary" value="&lt;b&gt;Quy tắc Phân định Ranh giới Workspace:&lt;/b&gt; Thành viên tổ chức (Viện/Trường/Doanh nghiệp) &lt;b&gt;KHÔNG&lt;/b&gt; tự động có quyền Governance/Admin. Mỗi người dùng chỉ thấy dữ liệu, đề xuất và dự án trong đúng phạm vi vai trò và ngữ cảnh được cấp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a5b4fc;fontSize=11;fontColor=#3730a3;" vertex="1" parent="z2_container">
          <mxGeometry x="30" y="270" width="1700" height="40" as="geometry" />
        </mxCell>

        <mxCell id="z2_table" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse; width:100%; font-size:10.5px;&quot;&gt;&lt;tr style=&quot;background-color:#e0e7ff; font-weight:bold; color:#1e1b4b;&quot;&gt;&lt;td&gt;Permission Code (Mã Quyền)&lt;/td&gt;&lt;td&gt;Mô tả Nghiệp vụ&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;Researcher&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;Reviewer&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;Org Admin&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;Enterprise&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;Leadership&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;GRANT.PROPOSAL.CREATE&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Khởi tạo đề xuất tài trợ mới&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;✅ Full&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;GRANT.PROPOSAL.READ&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Xem thông tin đề xuất&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;👁️ Own only&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;👁️ Assigned only&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;👁️ Org only&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;👁️ Summary&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;GRANT.PROPOSAL.REVIEW&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Nhập điểm và ý kiến đánh giá&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;✅ Assigned&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;ORG.MEMBER.MANAGE&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Duyệt thành viên thuộc Viện/Trường&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;✅ Org Bound&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;TECH.2PLUS2.SUBMIT&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Nộp hồ sơ chuyển giao công nghệ 2+2&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;✅ Co-submit&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;✅ Org Bound&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;✅ Enterprise&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7d2fe;align=left;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="z2_container">
          <mxGeometry x="30" y="325" width="1700" height="150" as="geometry" />
        </mxCell>

        <!-- ZONE 3: GOVERNANCE & ADMIN -->
        <mxCell id="z3_container" value="KHU VỰC 3: GOVERNANCE &amp;amp; ADMINISTRATION (ĐỘI NGŨ VẬN HÀNH QUỸ &amp;amp; QUẢN TRỊ HỆ THỐNG)" style="swimlane;startSize=30;fillColor=#fdf4ff;strokeColor=#c026d3;fontStyle=1;fontSize=13;fontColor=#86198f;rounded=1;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="845" width="1760" height="360" as="geometry" />
        </mxCell>

        <mxCell id="adm_iam" value="&lt;b style=&quot;font-size: 13px; color: #a21caf;&quot;&gt;👤 IAM_ADMIN (Quản trị Định danh &amp;amp; Phân quyền)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• ✅ &lt;code&gt;IAM.USER.MANAGE_LIFECYCLE&lt;/code&gt; (Kích hoạt, khóa tài khoản)&lt;br&gt;• ✅ &lt;code&gt;IAM.ROLE.ASSIGN_AND_REVOKE&lt;/code&gt; (Gán vai trò, thu hồi quyền)&lt;br&gt;• ✅ &lt;code&gt;IAM.SESSION.FORCE_LOGOUT&lt;/code&gt; (Ngắt phiên khẩn cấp)&lt;br&gt;• ✅ &lt;code&gt;IAM.MFA.RESET_CREDENTIAL&lt;/code&gt; (Hỗ trợ mở khóa 2FA)&lt;br&gt;• ❌ &lt;i style=&quot;color:#dc2626;&quot;&gt;Không sửa kết quả chấm điểm chuyên gia&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c026d3;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="z3_container">
          <mxGeometry x="30" y="48" width="410" height="150" as="geometry" />
        </mxCell>

        <mxCell id="adm_wf" value="&lt;b style=&quot;font-size: 13px; color: #a21caf;&quot;&gt;📋 WORKFLOW_GOVERNANCE_ADMIN (Vận hành Nghiệp vụ)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• ✅ &lt;code&gt;CATALOG.MASTER.MANAGE&lt;/code&gt; (Danh mục lĩnh vực, từ khóa)&lt;br&gt;• ✅ &lt;code&gt;GRANT.CALL.PUBLISH_ROUND&lt;/code&gt; (Tạo đợt kêu gọi tài trợ)&lt;br&gt;• ✅ &lt;code&gt;GRANT.REVIEW_BOARD.ALLOCATE&lt;/code&gt; (Phân bổ hồ sơ cho Hội đồng)&lt;br&gt;• ✅ &lt;code&gt;GRANT.DECISION.EXECUTE_FUND_APPROVAL&lt;/code&gt; (Phê duyệt tài trợ Quỹ)&lt;br&gt;• ❌ &lt;i style=&quot;color:#dc2626;&quot;&gt;Không quản trị ngân sách cấp nhà nước (thuộc cơ quan thẩm quyền)&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c026d3;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="z3_container">
          <mxGeometry x="460" y="48" width="430" height="150" as="geometry" />
        </mxCell>

        <mxCell id="adm_sec" value="&lt;b style=&quot;font-size: 13px; color: #a21caf;&quot;&gt;🛡️ AUDIT_SECURITY_ADMIN (Kiểm toán &amp;amp; An ninh)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• ✅ &lt;code&gt;AUDIT.LOG.VIEW_ALL_TRAILS&lt;/code&gt; (Xem toàn bộ vết kiểm toán)&lt;br&gt;• ✅ &lt;code&gt;AUDIT.EVENT.ANALYZE_ANOMALY&lt;/code&gt; (Phân tích hành vi bất thường)&lt;br&gt;• ✅ &lt;code&gt;AUDIT.EXPORT.COMPLIANCE_REPORT&lt;/code&gt; (Xuất báo cáo tuân thủ)&lt;br&gt;• ✅ &lt;code&gt;SECURITY.ALERT.CONFIGURE_RULE&lt;/code&gt; (Cấu hình ngưỡng cảnh báo)&lt;br&gt;• 🔒 &lt;i&gt;Chế độ kiểm toán độc lập, không chỉnh sửa nhật ký&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c026d3;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="z3_container">
          <mxGeometry x="910" y="48" width="410" height="150" as="geometry" />
        </mxCell>

        <mxCell id="adm_super" value="&lt;b style=&quot;font-size: 13px; color: #a21caf;&quot;&gt;⚡ SUPER_ADMIN (Quản trị Tối cao Hệ thống)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.4;&quot;&gt;• ✅ &lt;code&gt;SYSTEM.CONFIG.GLOBAL_PARAM_UPDATE&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;SYSTEM.MAINTENANCE.TOGGLE_MODE&lt;/code&gt;&lt;br&gt;• ✅ &lt;code&gt;BREAKGLASS.ACCESS.EMERGENCY_OVERRIDE&lt;/code&gt;&lt;br&gt;• ⚠️ &lt;i style=&quot;color:#e11d48;&quot;&gt;Quyền hạn tối cao — Bắt buộc xác thực 2FA phần cứng &amp;amp; ghi log kiểm toán bắt buộc mức khẩn cấp&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c026d3;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="z3_container">
          <mxGeometry x="1340" y="48" width="390" height="150" as="geometry" />
        </mxCell>

        <mxCell id="z3_table" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse; width:100%; font-size:10.5px;&quot;&gt;&lt;tr style=&quot;background-color:#fae8ff; font-weight:bold; color:#701a75;&quot;&gt;&lt;td&gt;Governance Permission Code&lt;/td&gt;&lt;td&gt;Mục đích Quản trị&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;IAM Admin&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;Workflow Admin&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;Audit Security&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;Super Admin&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;IAM.USER.MANAGE&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Tạo, kích hoạt, khóa tài khoản người dùng&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;✅ Full&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;👁️ Read&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;✅ Full&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;IAM.ROLE.ASSIGN&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Gán vai trò hoặc phân quyền cho người dùng&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;✅ Full&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;👁️ Read&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;✅ Full&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;GRANT.BOARD.MANAGE&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Quản trị danh sách Hội đồng và phân công hồ sơ&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;✅ Full&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;👁️ Read&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;✅ Full&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;AUDIT.LOG.VIEW&lt;/code&gt;&lt;/td&gt;&lt;td&gt;Truy vấn nhật ký kiểm toán hệ thống&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;👁️ IAM only&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;❌&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;✅ Full Global&lt;/td&gt;&lt;td align=&quot;center&quot;&gt;✅ Full Global&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f0abfc;align=left;verticalAlign=top;spacingTop=6;spacingLeft=6;" vertex="1" parent="z3_container">
          <mxGeometry x="30" y="215" width="1700" height="130" as="geometry" />
        </mxCell>

        <!-- CONVENTION & FOOTER -->
        <mxCell id="p3_footer" value="&lt;b&gt;QUY ƯỚC CHUẨN HÓA MÃ QUYỀN (PERMISSION CONVENTIONS):&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;code style=&quot;background:#e2e8f0; padding:2px 6px; font-weight:bold;&quot;&gt;&amp;lt;DOMAIN&amp;gt;.&amp;lt;RESOURCE&amp;gt;.&amp;lt;ACTION&amp;gt;&lt;/code&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;Domains:&lt;/b&gt; IAM | GRANT | KNOWLEDGE | ORG | TECH | REPORT | AUDIT | SYSTEM&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;Actions:&lt;/b&gt; CREATE | READ | UPDATE | DELETE | REVIEW | APPROVE | MANAGE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontSize=11;fontColor=#334155;align=center;" vertex="1" parent="1">
