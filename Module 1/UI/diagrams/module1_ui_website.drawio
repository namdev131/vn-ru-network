        <mxCell id="sim_title" value="&lt;b style=&quot;font-size:14px; color:#004d40;&quot;&gt;🧪 TRÌNH KIỂM THỬ PHÂN QUYỀN THỜI GIAN THỰC&lt;/b&gt;&lt;hr&gt;&lt;span style=&quot;font-size:11px; color:#546e7a;&quot;&gt;Mô phỏng truy cập để kiểm tra tính toàn vẹn của Scope và Context&lt;/span&gt;" style="text;html=1;align=left;" vertex="1" parent="sim_card">
