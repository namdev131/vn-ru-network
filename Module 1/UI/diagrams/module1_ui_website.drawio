        <mxCell id="sim_res_title" value="&lt;b style=&quot;color:#be123c; font-size:13px;&quot;&gt;🚫 KẾT QUẢ ĐÁNH GIÁ: DENIED (403 FORBIDDEN)&lt;/b&gt;&lt;hr&gt;" style="text;html=1;align=left;" vertex="1" parent="sim_res_box">
