        <mxCell id="sim_res_body" value="&lt;div align=&quot;left&quot; style=&quot;font-size:11px; line-height:1.45;&quot;&gt;&lt;b&gt;Chi tiết đánh giá phân quyền (ABAC Rule Match):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Xác thực Identity:&lt;/b&gt; &lt;span style=&quot;color:#15803d;&quot;&gt;✅ u_nguyenva (Token hợp lệ)&lt;/span&gt;&lt;br&gt;• &lt;b&gt;Khớp Vai trò:&lt;/b&gt; &lt;span style=&quot;color:#15803d;&quot;&gt;✅ HOTEL_FRONTDESK có 13 quyền nghiệp vụ&lt;/span&gt;&lt;br&gt;• &lt;b&gt;Resource Scope Check:&lt;/b&gt; &lt;span style=&quot;color:#be123c; font-weight:bold;&quot;&gt;❌ THẤT BẠI&lt;/span&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- Hồ sơ được phân công: &lt;code&gt;['R100', 'R104']&lt;/code&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- Hồ sơ cố gắng truy cập: &lt;code&gt;'P099'&lt;/code&gt; (Không thuộc Scope)&lt;br&gt;&lt;br&gt;• &lt;b&gt;Tốc độ phản hồi AuthZ:&lt;/b&gt; &lt;b style=&quot;color:#0284c7;&quot;&gt;1.12 ms (Redis Cache Hit)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Audit Action:&lt;/b&gt; Đã tự động ghi nhận mã sự kiện &lt;code&gt;trace-8f92c9&lt;/code&gt; vào kho &lt;b style=&quot;color:#be123c;&quot;&gt;Security Audit Store&lt;/b&gt;.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="sim_res_box">
          <mxGeometry x="15" y="40" width="480" height="280" as="geometry" />
        </mxCell>

