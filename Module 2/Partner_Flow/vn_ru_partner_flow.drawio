        <mxCell id="edge_p5_to_dash" value="Sync Bilateral Cooperation KPI Facts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#43a047;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5_academic_spread" target="p5_dashboard">
