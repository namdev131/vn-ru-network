        <mxCell id="edge_tb_3_4" value="IP / Legal Agreement Signed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#ef6c00;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="track_b_box" source="tb_step3" target="tb_step4">
          <mxGeometry relative="1" as="geometry" />
