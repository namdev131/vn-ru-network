        <!-- Inside Track A Flow -->
        <mxCell id="edge_ta_1_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#0288d1;strokeWidth=1.5;" edge="1" parent="track_a_box" source="ta_step1" target="ta_step2">
