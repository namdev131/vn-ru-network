        <!-- Phase 2 to Phase 3 -->
        <mxCell id="edge_p2_p3" value="Select Match / Initiate Contact" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#7e57c2;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2_output" target="p3_decision">
          <mxGeometry relative="1" as="geometry" />
