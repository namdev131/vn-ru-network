        <!-- Phase 4 to Phase 5 Outputs -->
        <mxCell id="edge_p4_to_knowledge" value="Publish Papers &amp;amp; Patents" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#7e57c2;strokeWidth=1.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="track_a_box" target="p5_knowledge_feedback">
