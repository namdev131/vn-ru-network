<mxfile host="Electron">
  <diagram id="module4_academic_training" name="Kiến trúc Hệ thống Module 4 - Đào tạo, Chuyển giao Tri thức &amp; Trao đổi Học thuật">
    <mxGraphModel dx="672" dy="490" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#4a6b82;strokeWidth=1.5;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size: 20px; color: #1a237e;&quot;&gt;KIẾN TRÚC HỆ THỐNG MODULE 4: ĐÀO TẠO, CHUYỂN GIAO TRI THỨC &amp;amp; TRAO ĐỔI HỌC THUẬT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #546e7a;&quot;&gt;VN–RU Portal · Cổng một cửa Quản lý Sự kiện Khoa học, Diễn đàn Tri thức Việt–Nga, Đăng ký Tham gia &amp;amp; Lan tỏa Tri thức Học thuật&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="1520" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="tier1_container" parent="1" style="swimlane;startSize=30;fillColor=#e1f5fe;strokeColor=#0288d1;fontStyle=1;fontSize=12;fontColor=#01579b;rounded=1;arcSize=4;" value="TẦNG 1: TRẢI NGHIỆM TRUY CẬP (3 CANONICAL ACCESS ZONES)" vertex="1">
          <mxGeometry height="185" width="1520" x="40" y="120" as="geometry" />
        </mxCell>
        <mxCell id="zone_public" parent="tier1_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" value="&lt;b&gt;PUBLIC / DISCOVERY ZONE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555;&quot;&gt;(Khách vãng lai / Unauthenticated)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.45;&quot;&gt;• &lt;b&gt;Danh mục Sự kiện &amp;amp; Khóa đào tạo:&lt;/b&gt; Tin tức, hội thảo, tọa đàm&lt;br&gt;• &lt;b&gt;Diễn đàn Tri thức Việt – Nga:&lt;/b&gt; Lịch trình, chủ đề, diễn giả song phương&lt;br&gt;• &lt;b&gt;Tìm kiếm &amp;amp; Lọc theo Taxonomy:&lt;/b&gt; Chủ đề, chuyên ngành, đơn vị tổ chức&lt;br&gt;• &lt;b&gt;Điểm vào Tham gia:&lt;/b&gt; Xem điều kiện, hướng dẫn &amp;amp; nút Sign in / Register&lt;/div&gt;" vertex="1">
          <mxGeometry height="128" width="440" x="30" y="42" as="geometry" />
        </mxCell>
        <mxCell id="zone_workspace" parent="tier1_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" value="&lt;b&gt;ROLE-BASED WORKSPACE ZONE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555;&quot;&gt;(Thành viên đã xác thực / Authenticated)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.45;&quot;&gt;• &lt;b&gt;Scientist / Researcher (VN &amp;amp; RU):&lt;/b&gt; My Activities, nộp bài báo cáo, vé QR&lt;br&gt;• &lt;b&gt;Organization Representative:&lt;/b&gt; Soạn &amp;amp; quản lý hoạt động trong Org Scope&lt;br&gt;• &lt;b&gt;Speaker / Instructor:&lt;/b&gt; Quản lý tài liệu bài giảng, phiên trình bày chuyên môn&lt;br&gt;• &lt;b&gt;Academic Material Vault:&lt;/b&gt; Truy cập slide, video, kỷ yếu khi có quyền&lt;/div&gt;" vertex="1">
          <mxGeometry height="128" width="500" x="510" y="42" as="geometry" />
        </mxCell>
        <mxCell id="zone_gov" parent="tier1_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" value="&lt;b&gt;GOVERNANCE &amp;amp; ADMIN ZONE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555;&quot;&gt;(Ban Điều phối Quỹ &amp;amp; Quản trị Mạng lưới)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.45;&quot;&gt;• &lt;b&gt;Moderation &amp;amp; Publish Queue:&lt;/b&gt; Kiểm duyệt hoạt động do Viện/Trường gửi&lt;br&gt;• &lt;b&gt;Taxonomy &amp;amp; Visibility Manager:&lt;/b&gt; Cấu hình phân loại &amp;amp; chế độ công khai&lt;br&gt;• &lt;b&gt;Capacity &amp;amp; Waitlist Rules:&lt;/b&gt; Thiết lập giới hạn chỗ &amp;amp; điều kiện tham dự&lt;br&gt;• &lt;b&gt;Audit &amp;amp; Security Monitoring:&lt;/b&gt; Truy vết thay đổi nhạy cảm &amp;amp; quyền truy cập&lt;/div&gt;" vertex="1">
          <mxGeometry height="128" width="440" x="1050" y="42" as="geometry" />
        </mxCell>
        <mxCell id="tier2_container" parent="1" style="swimlane;startSize=30;fillColor=#fff3e0;strokeColor=#ef6c00;fontStyle=1;fontSize=12;fontColor=#e65100;rounded=1;arcSize=4;" value="TẦNG 2: API GATEWAY &amp; XỬ LÝ QUY TRÌNH HOẠT ĐỘNG (DISCOVERY, MODERATION &amp; CAPACITY PIPELINE)" vertex="1">
          <mxGeometry height="210" width="1520" x="40" y="340" as="geometry" />
        </mxCell>
        <mxCell id="gw_entry" parent="tier2_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#fb8c00;strokeWidth=1.5;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;API Gateway &amp;amp; Traffic Controller&lt;/b&gt;&lt;br&gt;• SSL/TLS Termination&lt;br&gt;• DDoS &amp;amp; Rate Limiting Shield&lt;br&gt;• Forward Auth Context (Module 1)&lt;br&gt;• Trace ID &amp;amp; Correlation Header" vertex="1">
          <mxGeometry height="135" width="250" x="30" y="50" as="geometry" />
        </mxCell>
        <mxCell id="pipe_moderation" parent="tier2_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f57c00;strokeWidth=1.2;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;1. Org Scope &amp;amp; Moderation Pipeline&lt;/b&gt;&lt;br&gt;• Kiểm tra ủy quyền đơn vị (&lt;i&gt;Org Scope&lt;/i&gt;)&lt;br&gt;• Sàng lọc nội dung &amp;amp; quy chuẩn học thuật&lt;br&gt;• Phân luồng: Publish trực tiếp / Qua duyệt&lt;br&gt;• State: &lt;i&gt;DRAFT → READY_FOR_PUBLISH&lt;/i&gt;" vertex="1">
          <mxGeometry height="135" width="260" x="320" y="50" as="geometry" />
        </mxCell>
        <mxCell id="pipe_capacity" parent="tier2_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f57c00;strokeWidth=1.2;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;2. Capacity &amp;amp; Anti-Overbooking Engine&lt;/b&gt;&lt;br&gt;• Distributed Lock hạn mức chỗ (Redis Lock)&lt;br&gt;• Idempotent Registration (Chống trùng lặp)&lt;br&gt;• Phân loại: &lt;i&gt;CONFIRMED / WAITLISTED&lt;/i&gt;&lt;br&gt;• Rule linh hoạt: Mở tự do / Bắt buộc duyệt" vertex="1">
          <mxGeometry height="135" width="260" x="620" y="50" as="geometry" />
        </mxCell>
        <mxCell id="pipe_hybrid" parent="tier2_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f57c00;strokeWidth=1.2;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;3. Hybrid Event &amp;amp; Check-in Router&lt;/b&gt;&lt;br&gt;• Tạo vé điện tử &amp;amp; mã QR Check-in&lt;br&gt;• Điều phối phòng họp trực tuyến/Livestream&lt;br&gt;• Ghi nhận tham dự: &lt;i&gt;CONFIRMED → ATTENDED&lt;/i&gt;&lt;br&gt;• Quản lý tương tác Q&amp;amp;A phiên song phương" vertex="1">
          <mxGeometry height="135" width="280" x="920" y="50" as="geometry" />
        </mxCell>
        <mxCell id="pipe_event" parent="tier2_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f57c00;strokeWidth=1.2;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;4. Knowledge Sync &amp;amp; Event Dispatcher&lt;/b&gt;&lt;br&gt;• Phát sự kiện: &lt;i&gt;AcademicActivityPublished&lt;/i&gt;&lt;br&gt;• Liên kết tài liệu sang Module 2 (Knowledge)&lt;br&gt;• Kích hoạt cơ hội đề xuất sang Module 3&lt;br&gt;• Audit Emitter &amp;amp; OpenTelemetry Traces" vertex="1">
          <mxGeometry height="135" width="250" x="1240" y="50" as="geometry" />
        </mxCell>
        <mxCell id="tier3_container" parent="1" style="swimlane;startSize=30;fillColor=#ede7f6;strokeColor=#7e57c2;fontStyle=1;fontSize=12;fontColor=#4a148c;rounded=1;arcSize=4;" value="TẦNG 3: CÁC DỊCH VỤ NGHIỆP VỤ LÕI (CORE DOMAIN SERVICES - BUSINESS LOGIC)" vertex="1">
          <mxGeometry height="230" width="1520" x="40" y="580" as="geometry" />
        </mxCell>
        <mxCell id="svc_activity" parent="tier3_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" value="&lt;b&gt;Academic Activity Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;Route: /activities, /events, /workshops&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Quản lý danh mục sự kiện, khóa đào tạo&lt;br&gt;• Phân loại Canonical: &lt;i&gt;TRAINING, ACADEMIC_EXCHANGE, FORUM, TRANSFER&lt;/i&gt;&lt;br&gt;• Cấu hình lịch trình, địa điểm &amp;amp; visibility&lt;br&gt;• State: &lt;i&gt;DRAFT / PUBLISHED / CLOSED&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="270" x="30" y="45" as="geometry" />
        </mxCell>
        <mxCell id="svc_participation" parent="tier3_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" value="&lt;b&gt;Participation &amp;amp; Registration Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;Route: /participations, /registrations&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Quản lý đăng ký tham dự của nhà khoa học&lt;br&gt;• Kiểm tra điều kiện, tư cách tham gia&lt;br&gt;• Xử lý danh sách chờ (Waitlist Management)&lt;br&gt;• State: &lt;i&gt;SUBMITTED/CONFIRMED/WAITLIST/ATTENDED&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="280" x="330" y="45" as="geometry" />
        </mxCell>
        <mxCell id="svc_forum" parent="tier3_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" value="&lt;b&gt;VN–RU Knowledge Forum Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: rgb(85, 85, 85);&quot;&gt;Route: /forums, /annual-sessions&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Điều phối Diễn đàn Tri thức Nga - Việt&lt;br&gt;• Quản lý phiên song phương, Keynote &amp;amp; Chair&lt;br&gt;• Tiếp nhận báo cáo tham luận chuyên đề&lt;br&gt;• Khớp nối kết nối thảo luận chuyên sâu&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="280" x="640" y="45" as="geometry" />
        </mxCell>
        <mxCell id="svc_material" parent="tier3_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" value="&lt;b&gt;Academic Material &amp;amp; Artifact Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;Route: /materials, /proceedings&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Quản lý tài liệu bài giảng, kỷ yếu, slide&lt;br&gt;• Phân quyền truy cập tài liệu theo chính sách&lt;br&gt;• Tạo liên kết tham chiếu (Reference Links)&lt;br&gt;• Chuẩn hóa metadata tài liệu sau sự kiện&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="260" x="950" y="45" as="geometry" />
        </mxCell>
        <mxCell id="svc_transfer" parent="tier3_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" value="&lt;b&gt;Knowledge Transfer &amp;amp; Handoff Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;Route: /knowledge-transfer, /handoff&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Lan tỏa tri thức &amp;amp; kết nối mạng lưới học thuật&lt;br&gt;• Đồng bộ kết quả sang Module 2 (Knowledge)&lt;br&gt;• Handoff ý tưởng phát sinh sang Module 3 (Grant)&lt;br&gt;• Đo lường hiệu quả chuyển giao tri thức&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="250" x="1240" y="45" as="geometry" />
        </mxCell>
        <mxCell id="tier4_container" parent="1" style="swimlane;startSize=30;fillColor=#e8f5e9;strokeColor=#43a047;fontStyle=1;fontSize=12;fontColor=#1b5e20;rounded=1;arcSize=4;" value="TẦNG 4: LƯU TRỮ GIAO DỊCH, TÀI LIỆU &amp; KIỂM TOÁN (MULTI-MODEL PERSISTENCE &amp; AUDIT STORE)" vertex="1">
          <mxGeometry height="190" width="1520" x="40" y="850" as="geometry" />
        </mxCell>
        <mxCell id="db_relational" parent="tier4_container" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=1.5;size=15;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;Primary Relational DB (PostgreSQL)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Source of Truth (ACID Transactions)&lt;/i&gt;&lt;br&gt;• Tables: &lt;i&gt;AcademicActivities, ActivityTopics&lt;/i&gt;&lt;br&gt;• &lt;i&gt;Participations, Attendees, Sessions, Speakers&lt;/i&gt;&lt;br&gt;• &lt;i&gt;MaterialRefs, ModerationLogs&lt;/i&gt;&lt;br&gt;• Optimistic Locking Control (&lt;i&gt;version, updatedAt&lt;/i&gt;)" vertex="1">
          <mxGeometry height="120" width="320" x="30" y="45" as="geometry" />
        </mxCell>
        <mxCell id="db_redis" parent="tier4_container" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=1.5;size=15;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;Redis Cache &amp;amp; Distributed Locks&lt;/b&gt;&lt;br&gt;&lt;i&gt;Performance &amp;amp; Concurrency Control&lt;/i&gt;&lt;br&gt;• Active Events Metadata &amp;amp; Schedule Cache&lt;br&gt;• Distributed Lock hạn chế Overbooking&lt;br&gt;• Idempotency Token Cache (Anti-duplicate)&lt;br&gt;• AuthZ Permission &amp;amp; Org Scope TTL" vertex="1">
          <mxGeometry height="120" width="340" x="390" y="45" as="geometry" />
        </mxCell>
        <mxCell id="db_storage" parent="tier4_container" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=1.5;size=15;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;Object Store / Document Storage (S3/MinIO)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Academic Artifacts &amp;amp; Media Repository&lt;/i&gt;&lt;br&gt;• Kỷ yếu hội thảo &amp;amp; Bài tham luận (PDF)&lt;br&gt;• Slide bài giảng đào tạo (PPTX / PDF)&lt;br&gt;• Video ghi hình phiên thảo luận &amp;amp; Forum&lt;br&gt;• Chứng nhận tham dự điện tử (E-Certificate)" vertex="1">
          <mxGeometry height="120" width="340" x="770" y="45" as="geometry" />
        </mxCell>
        <mxCell id="db_audit" parent="tier4_container" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;strokeWidth=1.5;size=15;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;Security Audit &amp;amp; State Event Store&lt;/b&gt;&lt;br&gt;&lt;i&gt;Immutable Log &amp;amp; Traceability&lt;/i&gt;&lt;br&gt;• &lt;i&gt;AcademicActivityPublished&lt;/i&gt;&lt;br&gt;• &lt;i&gt;ParticipationConfirmed / Denied&lt;/i&gt;&lt;br&gt;• &lt;i&gt;UnauthorizedActivityChangeDenied&lt;/i&gt;&lt;br&gt;• OpenTelemetry Traces &amp;amp; Correlation IDs" vertex="1">
          <mxGeometry height="120" width="340" x="1150" y="45" as="geometry" />
        </mxCell>
        <mxCell id="tier5_container" parent="1" style="swimlane;startSize=30;fillColor=#eceff1;strokeColor=#607d8b;fontStyle=1;fontSize=12;fontColor=#263238;rounded=1;arcSize=4;" value="TẦNG 5: RANH GIỚI TÍCH HỢP LIÊN PHÂN HỆ &amp; MẠNG LƯỚI BÊN NGOÀI (INTEGRATION BOUNDARIES &amp; DOMAIN REFERENCING)" vertex="1">
          <mxGeometry height="170" width="1520" x="40" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="dom_iam" parent="tier5_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#607d8b;strokeWidth=1.2;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;Module 1: IAM &amp;amp; Governance&lt;/b&gt;&lt;br&gt;• Identity, User &amp;amp; Org Scopes&lt;br&gt;• Functional Permissions Check&lt;br&gt;• Audit Policy Enforcement" vertex="1">
          <mxGeometry height="100" width="260" x="30" y="45" as="geometry" />
        </mxCell>
        <mxCell id="dom_knowledge" parent="tier5_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#607d8b;strokeWidth=1.2;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;Module 2: Kho Tri thức &amp;amp; Chuyên gia&lt;/b&gt;&lt;br&gt;• Gợi ý Diễn giả / Keynote VN–RU&lt;br&gt;• Tiếp nhận tham chiếu tài liệu học thuật&lt;br&gt;&lt;i style=&quot;color:#d32f2f;&quot;&gt;→ Giữ chuẩn phân định Knowledge Domain&lt;/i&gt;" vertex="1">
          <mxGeometry height="100" width="280" x="320" y="45" as="geometry" />
        </mxCell>
        <mxCell id="dom_grant" parent="tier5_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#607d8b;strokeWidth=1.2;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;Module 3: Quản lý Tài trợ Độc lập&lt;/b&gt;&lt;br&gt;• Chuyển tiếp đề xuất nghiên cứu phát sinh&lt;br&gt;• Không có nhánh hỗ trợ tài chính trong M4&lt;br&gt;&lt;i style=&quot;color:#d32f2f;&quot;&gt;→ Chuyển hồ sơ grant sang Module 3&lt;/i&gt;" vertex="1">
          <mxGeometry height="100" width="280" x="630" y="45" as="geometry" />
        </mxCell>
        <mxCell id="dom_transfer_tech" parent="tier5_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#607d8b;strokeWidth=1.2;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;Module 5: Chuyển giao Công nghệ &amp;amp; 2+2&lt;/b&gt;&lt;br&gt;• Lan tỏa kết quả nghiên cứu tới doanh nghiệp&lt;br&gt;• Tổ chức tọa đàm kết nối Viện–Doanh nghiệp&lt;br&gt;&lt;i style=&quot;color:#d32f2f;&quot;&gt;→ Cầu nối thương mại hóa công nghệ&lt;/i&gt;" vertex="1">
          <mxGeometry height="100" width="270" x="940" y="45" as="geometry" />
        </mxCell>
        <mxCell id="dom_dashboard" parent="tier5_container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#607d8b;strokeWidth=1.2;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;Module 6: Dashboard Giám sát&lt;/b&gt;&lt;br&gt;• Thống kê người tham gia &amp;amp; quy mô sự kiện&lt;br&gt;• Chỉ số lan tỏa học thuật song phương&lt;br&gt;• Đọc facts/events, không giữ state" vertex="1">
          <mxGeometry height="100" width="250" x="1240" y="45" as="geometry" />
        </mxCell>
        <mxCell id="legend_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#90a4ae;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;CHÚ THÍCH &amp;amp; TIÊU CHUẨN KẾT NỐI (LEGEND)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;&lt;span style=&quot;color:#0288d1;&quot;&gt;━▶&lt;/span&gt; &lt;b&gt;HTTP/REST/gRPC Synchronous Request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#ef6c00;&quot;&gt;━▶&lt;/span&gt; &lt;b&gt;Internal Pipeline / Engine Flow&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#7e57c2;&quot;&gt;━▶&lt;/span&gt; &lt;b&gt;Data Persistence &amp;amp; Cache Flow&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#607d8b;&quot;&gt;━▶&lt;/span&gt; &lt;b&gt;Async Event / Cross-Domain Integration&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="560" x="40" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="principles_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#90a4ae;align=left;verticalAlign=top;spacing=8;" value="&lt;b&gt;NGUYÊN TẮC THIẾT KẾ CỐT LÕI (ARCHITECTURE PRINCIPLES - MODULE 4)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.45;&quot;&gt;1. &lt;b&gt;Public Discovery &amp;amp; Mở rộng tiếp cận:&lt;/b&gt; Khách vãng lai xem được sự kiện/hội thảo đã công bố không cần login; chỉ yêu cầu xác thực khi đăng ký tham gia hoặc truy cập tài liệu giới hạn.&lt;br&gt;2. &lt;b&gt;Phân tách Activity State &amp;amp; Participation State:&lt;/b&gt; Vòng đời sự kiện (&lt;i&gt;DRAFT → PUBLISHED → CLOSED&lt;/i&gt;) hoàn toàn độc lập với trạng thái cá nhân đăng ký (&lt;i&gt;SUBMITTED → CONFIRMED → ATTENDED&lt;/i&gt;).&lt;br&gt;3. &lt;b&gt;Chống Overbooking &amp;amp; Idempotency:&lt;/b&gt; Cơ chế Distributed Lock và Idempotency Key bảo đảm không vượt quá hạn mức chỗ ngồi và xử lý an toàn khi retry nộp đăng ký.&lt;br&gt;4. &lt;b&gt;Ranh giới Tri thức &amp;amp; Không hỗ trợ tài chính riêng:&lt;/b&gt; Không tự ý biến tài liệu sự kiện thành official knowledge record (Module 2 sở hữu); hồ sơ có nhu cầu tài trợ được chuyển giao sang Module 3.&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="920" x="640" y="1280" as="geometry" />
        </mxCell>
