<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron">
  <diagram id="module5_transfer_2plus2" name="Quy trình Chuyển giao Công nghệ &amp; Mô hình Liên danh 2+2 Việt–Nga">
    <mxGraphModel dx="1650" dy="1750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Block -->
        <mxCell id="title" value="&lt;b style=&quot;font-size: 20px; color: #1a237e;&quot;&gt;QUY TRÌNH CHUYỂN GIAO CÔNG NGHỆ, KHỚP NỐI DOANH NGHIỆP &amp;amp; MÔ HÌNH LIÊN DANH 2+2 VIỆT – NGA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #546e7a;&quot;&gt;VN–RU Portal · Luồng Nghiệp vụ Toàn diện từ Phát hiện Cung–Cầu, Khớp nối, Thư Bày tỏ Quan tâm (EOI), Xác thực Liên danh 2+2, Tư vấn Pháp lý/SHTT đến Bàn giao &amp;amp; Thương mại hóa&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#4a6b82;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1570" height="70" as="geometry" />
        </mxCell>

        <!-- PHASE 1: SUPPLY & DEMAND DISCOVERY & MODERATION -->
        <mxCell id="phase1_container" value="GIAI ĐOẠN 1: KHỞI TẠO, SÀNG LỌC CUNG – CẦU &amp; KIỂM DUYỆT CÔNG NGHỆ (SUPPLY &amp; DEMAND INITIATION &amp; MODERATION)" style="swimlane;html=1;startSize=30;fillColor=#e1f5fe;strokeColor=#0288d1;fontStyle=1;fontSize=12;fontColor=#01579b;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="1570" height="210" as="geometry" />
        </mxCell>

        <mxCell id="p1_tech_creator" value="&lt;b&gt;1. Viện / Trường Đăng tải Hồ sơ Công nghệ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Authorized Research Org Rep VN / RU)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Soạn hồ sơ sáng chế, giải pháp kỹ thuật, mẫu thử&lt;br&gt;• Khai báo mức sẵn sàng công nghệ: &lt;b&gt;TRL 4–9&lt;/b&gt;&lt;br&gt;• Xác thực quyền sở hữu theo &lt;b&gt;Org Scope (Module 1)&lt;/b&gt;&lt;br&gt;• Trạng thái hồ sơ: &lt;b style=&quot;color:#0288d1;&quot;&gt;DRAFT → READY&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase1_container">
          <mxGeometry x="30" y="45" width="340" height="145" as="geometry" />
        </mxCell>

        <mxCell id="p1_enterprise_demand" value="&lt;b&gt;2. Doanh nghiệp Đăng Bài toán R&amp;amp;D / Ứng dụng&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Enterprise Representative VN / RU)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Khai báo bài toán kỹ thuật, mục tiêu đổi mới&lt;br&gt;• Thiết lập ngân sách dự kiến &amp;amp; thời hạn yêu cầu&lt;br&gt;• Phân quyền hiển thị: &lt;i&gt;Public Portal / Controlled Scope&lt;/i&gt;&lt;br&gt;• Trạng thái nhu cầu: &lt;b style=&quot;color:#0288d1;&quot;&gt;OPEN&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase1_container">
          <mxGeometry x="420" y="45" width="340" height="145" as="geometry" />
        </mxCell>

        <mxCell id="p1_moderation_check" value="&lt;b&gt;3. Hàng đợi Kiểm duyệt Quỹ (Moderation)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Foundation Moderation Queue)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Kiểm tra căn cứ pháp lý &amp;amp; tính hợp lệ của sáng chế&lt;br&gt;• Rà soát ranh giới bảo mật &amp;amp; quyền công bố thông tin&lt;br&gt;• Thẩm duyệt trước khi đẩy lên danh mục toàn Portal&lt;br&gt;• Ghi log kiểm toán thao tác: &lt;i&gt;ModerationAuditLog&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase1_container">
          <mxGeometry x="810" y="45" width="340" height="145" as="geometry" />
        </mxCell>

        <mxCell id="p1_publish_action" value="&lt;b&gt;4. Công bố Public &amp;amp; Đánh Index Tìm kiếm&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Public Technology &amp;amp; Demand Catalog)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Đẩy lên Public Technology Catalog &amp;amp; Opportunity List&lt;br&gt;• Đồng bộ Search Index theo TRL &amp;amp; Taxonomy ngành&lt;br&gt;• Phát sự kiện: &lt;b style=&quot;color:#0288d1;&quot;&gt;TechnologyPublished&lt;/b&gt;&lt;br&gt;• Trạng thái công nghệ: &lt;b style=&quot;color:#2e7d32;&quot;&gt;PUBLISHED&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase1_container">
          <mxGeometry x="1200" y="45" width="340" height="145" as="geometry" />
        </mxCell>

        <!-- PHASE 2: MATCHING & EXPRESSION OF INTEREST (EOI) -->
        <mxCell id="phase2_container" value="GIAI ĐOẠN 2: KHÁM PHÁ, KHỚP NỐI CUNG–CẦU &amp; GỬI THƯ BÀY TỎ QUAN TÂM (MATCHING &amp; EXPRESSION OF INTEREST)" style="swimlane;html=1;startSize=30;fillColor=#fff3e0;strokeColor=#ef6c00;fontStyle=1;fontSize=12;fontColor=#e65100;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="1570" height="210" as="geometry" />
        </mxCell>

        <mxCell id="p2_discovery" value="&lt;b&gt;1. Khám phá &amp;amp; Gợi ý Khớp nối Tự động&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Faceted Search &amp;amp; Matching Algorithm)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• DN tìm kiếm công nghệ theo ngành, TRL, viện-trường&lt;br&gt;• Engine gợi ý tự động kết nối Cung – Cầu tương thích&lt;br&gt;• Gợi ý chuyên gia đồng hành từ &lt;b&gt;Module 2 (Knowledge)&lt;/b&gt;&lt;br&gt;• Điểm vào: &lt;i&gt;Nút &quot;Bày tỏ quan tâm / Submit EOI&quot;&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase2_container">
          <mxGeometry x="30" y="45" width="340" height="145" as="geometry" />
        </mxCell>

        <mxCell id="p2_eoi_submit" value="&lt;b&gt;2. Doanh nghiệp Gửi Thư Bày tỏ Quan tâm (EOI)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Expression of Interest Submission)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Khai báo mục tiêu ứng dụng, năng lực tiếp nhận&lt;br&gt;• Đề xuất phương án phối hợp &amp;amp; quy mô chuyển giao&lt;br&gt;• Cơ chế &lt;b&gt;Idempotent Token&lt;/b&gt; chống nộp lặp EOI&lt;br&gt;• Trạng thái: &lt;b style=&quot;color:#ef6c00;&quot;&gt;EOI_SUBMITTED&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase2_container">
          <mxGeometry x="420" y="45" width="340" height="145" as="geometry" />
        </mxCell>

        <mxCell id="p2_eoi_review" value="&lt;b&gt;3. Đơn vị Sở hữu Rà soát &amp;amp; Phản hồi EOI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Owner Review &amp;amp; Interest Screening)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Viện/Trường tiếp nhận EOI trong Workspace riêng&lt;br&gt;• Đánh giá mức độ phù hợp của Doanh nghiệp đề xuất&lt;br&gt;• Quyết định: Tiếp nhận thảo luận / Từ chối có lý do&lt;br&gt;• Trạng thái: &lt;b style=&quot;color:#ef6c00;&quot;&gt;ACKNOWLEDGED / DECLINED&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase2_container">
          <mxGeometry x="810" y="45" width="340" height="145" as="geometry" />
        </mxCell>

        <mxCell id="p2_case_opened" value="&lt;b&gt;4. Mở Phòng Đàm phán (Collaboration Case)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Confidential Collaboration Case Initiation)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Khởi tạo Case hợp tác kín có phân quyền nghiêm ngặt&lt;br&gt;• Trao đổi trực tiếp giải pháp kỹ thuật &amp;amp; phương án sơ bộ&lt;br&gt;• Phát sự kiện: &lt;b style=&quot;color:#ef6c00;&quot;&gt;CollaborationCaseOpened&lt;/b&gt;&lt;br&gt;• Trạng thái Case: &lt;b style=&quot;color:#2e7d32;&quot;&gt;DISCUSSION / NEGOTIATION&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase2_container">
          <mxGeometry x="1200" y="45" width="340" height="145" as="geometry" />
        </mxCell>

        <!-- PHASE 3: 2+2 CONSORTIUM FORMATION & STRUCTURAL VALIDATION -->
        <mxCell id="phase3_container" value="GIAI ĐOẠN 3: HÌNH THÀNH &amp; XÁC THỰC CẤU TRÚC LIÊN DANH 2+2 (2+2 CONSORTIUM FORMATION &amp; STRUCTURAL VALIDATION)" style="swimlane;html=1;startSize=30;fillColor=#ede7f6;strokeColor=#7e57c2;fontStyle=1;fontSize=12;fontColor=#4a148c;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1570" height="230" as="geometry" />
        </mxCell>

        <mxCell id="p3_model_select" value="&lt;b&gt;1. Lựa chọn Mô hình Chuyển giao&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Direct Transfer vs 2+2 Consortium)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Hợp tác 1–1: Chuyển giao song phương trực tiếp&lt;br&gt;• &lt;b style=&quot;color:#7e57c2;&quot;&gt;Mô hình 2+2:&lt;/b&gt; Đòi hỏi liên danh 4 bên toàn diện&lt;br&gt;• Khởi tạo Workspace Liên danh: &lt;b&gt;Consortium #ID&lt;/b&gt;&lt;br&gt;• Trạng thái liên danh: &lt;b style=&quot;color:#7e57c2;&quot;&gt;FORMING&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase3_container">
          <mxGeometry x="30" y="45" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="p3_slots_box" value="&lt;b&gt;2. Ghép nối 4 Thành phần Bắt buộc (4 Canonical Slots)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 10.5px; line-height: 1.4;&quot;&gt;🇻🇳 &lt;b&gt;Slot 1:&lt;/b&gt; Viện / Trường Đại học Việt Nam (&lt;i&gt;VN Research Inst&lt;/i&gt;)&lt;br&gt;🇻🇳 &lt;b&gt;Slot 2:&lt;/b&gt; Doanh nghiệp Ứng dụng Việt Nam (&lt;i&gt;VN Enterprise&lt;/i&gt;)&lt;br&gt;🇷🇺 &lt;b&gt;Slot 3:&lt;/b&gt; Viện / Trường Đại học LB Nga (&lt;i&gt;RU Research Inst&lt;/i&gt;)&lt;br&gt;🇷🇺 &lt;b&gt;Slot 4:&lt;/b&gt; Doanh nghiệp LB Nga (&lt;i&gt;RU Enterprise&lt;/i&gt;)&lt;br&gt;&lt;i style=&quot;color:#7e57c2;&quot;&gt;Gửi thư mời điện tử &amp;amp; đính kèm thỏa thuận hợp tác liên danh&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase3_container">
          <mxGeometry x="350" y="45" width="370" height="160" as="geometry" />
        </mxCell>

        <mxCell id="p3_slot_confirm" value="&lt;b&gt;3. Xác nhận Độc lập Đa phương &amp;amp; Lock&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Distributed Lock &amp;amp; Verification)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Đại diện hợp pháp từng slot xác nhận tham gia&lt;br&gt;• Tải lên giấy ủy quyền / cam kết nguồn lực đơn vị&lt;br&gt;• &lt;b&gt;Redis Distributed Lock&lt;/b&gt; chống race-condition xác nhận&lt;br&gt;• Trạng thái slot: &lt;b style=&quot;color:#2e7d32;&quot;&gt;CONFIRMED (4/4 slots)&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase3_container">
          <mxGeometry x="760" y="45" width="330" height="160" as="geometry" />
        </mxCell>

        <mxCell id="p3_validation_engine" value="&lt;b&gt;4. Động cơ Kiểm định 2+2 (Structural Validation Engine)&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Kiểm tra nghiêm ngặt cấu trúc 4 bên theo Backend Rule:&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;code style=&quot;background:#eee; font-size:10px;&quot;&gt;VN_INST &amp;amp;&amp;amp; VN_ENT &amp;amp;&amp;amp; RU_INST &amp;amp;&amp;amp; RU_ENT&lt;/code&gt;&lt;br&gt;• Không chấp nhận lưu chuỗi type đơn giản&lt;br&gt;• Phát sự kiện: &lt;b style=&quot;color:#7e57c2;&quot;&gt;ConsortiumStructurallyCompleted&lt;/b&gt;&lt;br&gt;• Trạng thái: &lt;b style=&quot;color:#2e7d32;&quot;&gt;STRUCTURALLY_COMPLETE → ACTIVE&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7e57c2;strokeWidth=1.5;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase3_container">
          <mxGeometry x="1130" y="45" width="410" height="160" as="geometry" />
        </mxCell>

        <!-- PHASE 4: IP ADVISORY, NDA & LICENSING AGREEMENT -->
        <mxCell id="phase4_container" value="GIAI ĐOẠN 4: TƯ VẤN PHÁP LÝ, THỎA THUẬN BẢO MẬT &amp; BẢO VỆ SỞ HỮU TRÍ TUỆ (IP / LEGAL ADVISORY &amp; CONTRACT)" style="swimlane;html=1;startSize=30;fillColor=#fff8e1;strokeColor=#fbc02d;fontStyle=1;fontSize=12;fontColor=#f57f17;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="1570" height="210" as="geometry" />
        </mxCell>

        <mxCell id="p4_advisory_case" value="&lt;b&gt;1. Mở Vụ việc Tư vấn Pháp lý / SHTT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Advisory Case &amp;amp; IP Boundary)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Quỹ hỗ trợ kết nối chuyên gia pháp lý &amp;amp; SHTT độc lập&lt;br&gt;• &lt;i style=&quot;color:#d32f2f;&quot;&gt;Portal chỉ lưu reference vụ việc, không tự quyết IP&lt;/i&gt;&lt;br&gt;• Đánh giá phạm vi bảo hộ sáng chế tại VN &amp;amp; LB Nga&lt;br&gt;• Khởi tạo: &lt;b&gt;AdvisoryCase #ID&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fbc02d;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase4_container">
          <mxGeometry x="30" y="45" width="340" height="145" as="geometry" />
        </mxCell>

        <mxCell id="p4_nda_signing" value="&lt;b&gt;2. Ký kết Thỏa thuận Bảo mật Thông tin (NDA)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Multilateral Non-Disclosure Agreement)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Các bên ký thỏa thuận NDA bảo vệ bí mật công nghệ&lt;br&gt;• Xác lập trách nhiệm bảo mật thông số kỹ thuật &amp;amp; mã nguồn&lt;br&gt;• Tải lên bản ký số / scan có giá trị pháp lý&lt;br&gt;• Lưu trữ mã hóa tại &lt;b&gt;Encrypted S3 Document Vault&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fbc02d;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase4_container">
          <mxGeometry x="420" y="45" width="340" height="145" as="geometry" />
        </mxCell>

        <mxCell id="p4_licensing_terms" value="&lt;b&gt;3. Đàm phán Điều khoản Cấp phép / Chuyển nhượng&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Licensing / Technology Transfer Terms)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Thống nhất hình thức: Cấp phép độc quyền / Chuyển nhượng đứt đoạn&lt;br&gt;• Xác định cơ chế phí bản quyền (Royalty) &amp;amp; mốc thanh toán&lt;br&gt;• Phân chia quyền SHTT phát sinh trong tương lai (&lt;i&gt;Foreground IP&lt;/i&gt;)&lt;br&gt;• Trạng thái: &lt;b style=&quot;color:#f57f17;&quot;&gt;TERMS_AGREED&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fbc02d;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase4_container">
          <mxGeometry x="810" y="45" width="340" height="145" as="geometry" />
        </mxCell>

        <mxCell id="p4_contract_execution" value="&lt;b&gt;4. Ký kết Hợp đồng Chuyển giao Chính thức&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Final Transfer Agreement Execution)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Đại diện pháp luật các bên ký kết hợp đồng thương mại hóa&lt;br&gt;• Liên kết văn bản chứng từ pháp lý: &lt;b&gt;IPLegalArtifactRef&lt;/b&gt;&lt;br&gt;• Kích hoạt kế hoạch bàn giao công nghệ thực tế&lt;br&gt;• Trạng thái hợp đồng: &lt;b style=&quot;color:#2e7d32;&quot;&gt;SIGNED &amp;amp; EXECUTABLE&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fbc02d;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase4_container">
          <mxGeometry x="1200" y="45" width="340" height="145" as="geometry" />
        </mxCell>

        <!-- PHASE 5: EXECUTION, COMMERCIALIZATION & TRANSFER OUTCOME -->
        <mxCell id="phase5_container" value="GIAI ĐOẠN 5: THỰC THI CHUYỂN GIAO, THƯƠNG MẠI HÓA &amp; ĐỒNG BỘ MẠNG LƯỚI (EXECUTION &amp; OUTCOME)" style="swimlane;html=1;startSize=30;fillColor=#e8f5e9;strokeColor=#43a047;fontStyle=1;fontSize=12;fontColor=#1b5e20;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1060" width="1570" height="210" as="geometry" />
        </mxCell>

        <mxCell id="p5_implementation" value="&lt;b&gt;1. Bàn giao Kỹ thuật &amp;amp; Đào tạo Vận hành&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Technical Handover &amp;amp; Pilot Deployment)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Bàn giao hồ sơ thiết kế, quy trình công nghệ, mẫu vật&lt;br&gt;• Chuyên gia viện-trường hướng dẫn đào tạo kỹ thuật viên DN&lt;br&gt;• Triển khai dây chuyền thử nghiệm thực tế (Pilot Line)&lt;br&gt;• Trạng thái triển khai: &lt;b style=&quot;color:#1b5e20;&quot;&gt;IN_DEPLOYMENT&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#43a047;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase5_container">
          <mxGeometry x="30" y="45" width="340" height="145" as="geometry" />
        </mxCell>

        <mxCell id="p5_outcome_record" value="&lt;b&gt;2. Nghiệm thu &amp;amp; Ghi nhận Kết quả Chuyển giao&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Transfer Outcome &amp;amp; Acceptance Record)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Lập biên bản nghiệm thu chuyển giao hoàn tất&lt;br&gt;• Ghi nhận giá trị thương mại hóa, doanh thu kỳ vọng&lt;br&gt;• Phát sự kiện: &lt;b style=&quot;color:#1b5e20;&quot;&gt;TransferOutcomeRecorded&lt;/b&gt;&lt;br&gt;• Trạng thái cuối: &lt;b style=&quot;color:#2e7d32;&quot;&gt;TRANSFERRED / COMPLETED&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#43a047;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase5_container">
          <mxGeometry x="420" y="45" width="340" height="145" as="geometry" />
        </mxCell>

        <mxCell id="p5_knowledge_sync" value="&lt;b&gt;3. Đồng bộ Kết quả sang Module 2 (Knowledge)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Knowledge Base &amp;amp; Patent Applied Status)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Cập nhật trạng thái &quot;Đã thương mại hóa thành công&quot;&lt;br&gt;• Bổ sung ấn phẩm, báo cáo ứng dụng vào Kho tri thức&lt;br&gt;• Nâng cao uy tín và chỉ số đổi mới sáng tạo của Viện/Trường&lt;br&gt;• Không làm rò rỉ dữ liệu kỹ thuật mật của Doanh nghiệp&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#43a047;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase5_container">
          <mxGeometry x="810" y="45" width="340" height="145" as="geometry" />
        </mxCell>

        <mxCell id="p5_dashboard_metrics" value="&lt;b&gt;4. Đẩy Business Facts sang Module 6 (Dashboard)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #555;&quot;&gt;(Executive Analytics &amp;amp; Impact Reporting)&lt;/span&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px;&quot;&gt;• Thống kê số lượng hợp đồng chuyển giao thành công&lt;br&gt;• Đo lường hiệu quả mô hình liên danh 2+2 Việt–Nga&lt;br&gt;• Cung cấp dữ liệu báo cáo chiến lược cho Lãnh đạo Quỹ&lt;br&gt;• Đảm bảo nguyên tắc Read-only Analytics facts&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#43a047;strokeWidth=1.2;verticalAlign=top;align=center;spacingTop=6;" vertex="1" parent="phase5_container">
          <mxGeometry x="1200" y="45" width="340" height="145" as="geometry" />
        </mxCell>

        <!-- SUMMARY NOTES & PRINCIPLES -->
        <mxCell id="wf_legend" value="&lt;b&gt;QUY TẮC ĐIỀU PHỐI LUỒNG CHUYỂN GIAO &amp;amp; LIÊN DANH 2+2 (WORKFLOW PRINCIPLES):&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 11px; line-height: 1.45;&quot;&gt;• &lt;b&gt;Bảo mật Đa tầng:&lt;/b&gt; Toàn bộ thông số kỹ thuật mật, thỏa thuận NDA và hợp đồng chuyển giao được lưu trữ trong Object Storage mã hóa và chỉ cấp quyền truy cập theo vai trò/tổ chức tham gia (&lt;i&gt;Active Context + Org Scope&lt;/i&gt;).&lt;br&gt;• &lt;b&gt;Tính Toàn vẹn 2+2:&lt;/b&gt; Động cơ kiểm tra cấu trúc 2+2 chỉ kích hoạt khi đầy đủ 4 slot đại diện xác nhận chính thức. Quỹ giữ vai trò điều phối kết nối, không can thiệp áp đặt phân chia lợi ích thương mại giữa các bên.&lt;br&gt;• &lt;b&gt;Phân tách Trạng thái:&lt;/b&gt; Tách biệt hoàn toàn &lt;i&gt;Technology State (DRAFT → PUBLISHED)&lt;/i&gt;, &lt;i&gt;EOI State (OPEN → ACKNOWLEDGED)&lt;/i&gt;, &lt;i&gt;Consortium State (FORMING → COMPLETE → ACTIVE)&lt;/i&gt; và &lt;i&gt;Outcome State (TRANSFERRED)&lt;/i&gt;.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#90a4ae;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1290" width="1570" height="110" as="geometry" />
        </mxCell>

